import os, time, json, urllib.request, urllib.parse
from calibre.web.feeds.news import BasicNewsRecipe

class NasaOfficialTranslated(BasicNewsRecipe):
    title = 'NASA News (CN)'
    language = 'zh-CN'
    oldest_article = 7
    max_articles_per_feed = 15
    delay = 2  # 每次请求间隔2秒，防止被封
    auto_cleanup = True

    # 使用 NASA 官方最新的 Breaking News API
    feeds = [
        ('NASA Breaking News', 'https://www.nasa.gov/api/breaking-news.json'),
    ]

    def parse_index(self):
        articles = []
        try:
            # 伪装成浏览器访问 API
            req = urllib.request.Request(self.feeds[0][1])
            req.add_header('User-Agent', 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36')

            with urllib.request.urlopen(req, timeout=10) as response:
                data = json.loads(response.read().decode('utf-8'))

            # NASA API 返回的是列表，我们需要遍历它
            for item in data.get('collection', {}).get('items', []):
                title = item.get('data', [{}])[0].get('title', 'No Title')
                description = item.get('data', [{}])[0].get('description', '')
                url = item.get('links', [{}])[0].get('href', '')

                if not url or not title:
                    continue

                # --- 简单的翻译逻辑 (调用免费接口) ---
                # 注意：这是在线翻译，如果网络不通可能会失败，但不会导致整个抓取崩溃
                try:
                    trans_title = self.translate_text(title)
                    trans_desc = self.translate_text(description[:200]) # 只翻译前200字摘要
                except Exception:
                    trans_title = f"[EN] {title}" # 翻译失败则保留英文
                    trans_desc = description

                # 构建文章字典
                article = {
                    'title': trans_title,
                    'url': url,
                    'description': trans_desc,
                    'date': item.get('data', [{}])[0].get('date_created', ''),
                }
                articles.append(article)

        except Exception as e:
            self.report_progress(0, f'Error fetching feed: {str(e)}')

        return [('NASA Latest News', articles)]

    def translate_text(self, text):
        """调用 MyMemory 免费翻译接口"""
        if not text:
            return ""
        try:
            encoded_text = urllib.parse.quote(text.encode('utf-8'))
            url = f"https://api.mymemory.translated.net/get?q={encoded_text}&langpair=en|zh-CN"
            req = urllib.request.Request(url)
            req.add_header('User-Agent', 'Calibre Ebook Generator')

            with urllib.request.urlopen(req, timeout=5) as response:
                data = json.loads(response.read().decode('utf-8'))
                return data['responseData']['translatedText']
        except:
            return text # 失败时返回原文
