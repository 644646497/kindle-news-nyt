import os, time, datetime
from calibre.web.feeds.news import BasicNewsRecipe

os.environ['TZ'] = 'Asia/Shanghai'
time.tzset()

class NasaBlogsChinese(BasicNewsRecipe):
    title = 'NASA News (Translated)'
    language = 'zh-CN'
    oldest_article = 7
    max_articles_per_feed = 15
    delay = 2  # 礼貌爬取，间隔2秒

    # ✅ 核心修改：使用 NASA 官方博客聚合源
    feeds = [
        ('NASA Official Blogs', 'https://blogs.nasa.gov/feed/'),
    ]

    def parse_index(self):
        articles = []
        try:
            feed = self.index_to_soup(self.feeds[0][1])
            for item in feed.findAll('item'):
                title = self.tag_to_string(item.find('title'))
                url = self.tag_to_string(item.find('link'))
                date = self.tag_to_string(item.find('pubDate'))
                summary = self.tag_to_string(item.find('description'))
                
                # 简单翻译标题和摘要（调用免费翻译接口）
                translated_title = self.translate_text(title)
                translated_summary = self.translate_text(summary)
                
                articles.append({
                    'title': translated_title,
                    'url': url,
                    'date': date,
                    'summary': translated_summary,
                })
        except Exception as e:
            self.log.error(f"解析索引失败: {e}")
        
        return [('NASA News (CN)', articles)]

    def translate_text(self, text):
        """简易翻译函数，调用 MyMemory 免费翻译 API"""
        if not text or len(text) < 5:
            return text
        try:
            import urllib.request, urllib.parse, json
            encoded_text = urllib.parse.quote(text)
            url = f"https://api.mymemory.translated.net/get?q={encoded_text}&langpair=en|zh-CN"
            req = urllib.request.Request(url)
            response = urllib.request.urlopen(req, timeout=10)
            data = json.loads(response.read().decode('utf-8'))
            return data.get('responseData', {}).get('translatedText', text)
        except:
            return text  # 翻译失败则返回原文
