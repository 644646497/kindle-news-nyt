import re, datetime
from calibre.web.feeds.news import BasicNewsRecipe

class NasaSimpleRecipe(BasicNewsRecipe):
    title = f'NASA 新闻 - {datetime.datetime.now().strftime("%Y-%m-%d")}'
    language = 'zh-CN'
    oldest_article = 7
    max_articles_per_feed = 10
    
    # 🔧 不设置 keep_only_tags，保留所有内容
    # 🔧 不设置 remove_tags
    
    feeds = [
        ('NASA 新闻', 'https://www.nasa.gov/news-release/feed/'),
    ]
    
    def postprocess_html(self, soup, first_fetch):
        """翻译所有可见文本"""
        try:
            from deep_translator import GoogleTranslator
            translator = GoogleTranslator(source='en', target='zh-CN')
            
            for tag in soup.find_all(['h1', 'h2', 'p']):
                text = tag.get_text(strip=True)
                if 15 < len(text) < 500 and re.search(r'[a-zA-Z]{3,}', text):
                    if not re.search(r'[\u4e00-\u9fff]', text):
                        try:
                            translated = translator.translate(text)
                            if translated:
                                tag.string = translated
                        except:
                            pass
        except:
            pass
        return soup
