import os, time, re, datetime
from calibre.web.feeds.news import BasicNewsRecipe
from calibre.ebooks.BeautifulSoup import BeautifulSoup

class NasaBlogsRecipe(BasicNewsRecipe):
    title = f'NASA Blogs - {datetime.datetime.now().strftime("%Y-%m-%d")}'
    language = 'en'  # 英文内容
    oldest_article = 7  # 抓取过去7天内的文章
    max_articles_per_feed = 15  # 最多抓取15篇
    auto_cleanup = True

    # 保留标题和正文区域 (这是针对“每篇文章详情页”的规则)
    keep_only_tags = [
        dict(name='h1'),  # 文章主标题
        dict(name='div', attrs={'class': re.compile(r'entry-content|post-content|field-content')}),  # 正文区域
        dict(name='article'),  # 整体文章容器
    ]

    # 移除侧边栏、分享按钮、页脚等噪音内容
    remove_tags = [
        dict(name='aside'), dict(name='nav'), dict(name='footer'), dict(name='header'),
        dict(name='div', attrs={'class': re.compile(r'sidebar|share|meta|comments|related|tags'})),
        dict(name='div', attrs={'class': re.compile(r'node__meta|field--name-field-tags')}),
        dict(name='script'), dict(name='style'),
    ]

    def parse_index(self):
        """
        主方法：解析博客列表页，提取每篇文章的链接和标题
        """
        articles = []
        index_url = 'https://www.nasa.gov/blogs/'
        soup = self.index_to_soup(index_url)

        # 1. 找到所有博客文章的链接 (在 <h2 class="node__title"> 下的 <a> 标签)
        for post in soup.find_all('h2', class_='node__title'):
            link_tag = post.find('a')
            if not link_tag:
                continue

            article_url = link_tag.get('href')
            # 确保是完整的URL
            if article_url.startswith('/'):
                article_url = 'https://www.nasa.gov' + article_url

            title = self.tag_to_string(link_tag)
            date_tag = post.find_parent('article').find('time') if post.find_parent('article') else None
            date_str = date_tag.get('datetime') if date_tag else ''

            # 2. 可选：根据日期过滤 (如果需要)
            # pub_date = self.parse_date(date_str) if date_str else None

            # 3. 创建文章条目格式 (feed, title, url, date, description)
            articles.append(('NASA Blogs', title, article_url, date_str, ''))
            if len(articles) >= self.max_articles_per_feed:
                break

        # 按日期排序 (最新的在前)
        # articles.sort(key=lambda x: x[3], reverse=True)

        # 4. 返回符合 calibre 要求的 feeds 结构
        return [(feed_name, articles) for feed_name, articles in [('NASA Blogs', articles)]]

    def preprocess_html(self, soup):
        """
        预处理单篇文章页面：移除页面的页眉页脚等全局噪音
        """
        # 移除 NASA 的全局导航栏
        for nav in soup.find_all(['header', 'footer', 'nav', 'div'], class_=re.compile(r'header|footer|nav')):
            nav.decompose()
        return soup

    def postprocess_html(self, soup, first_fetch):
        """
        后处理：清理多余的空白
        """
        for tag in soup.find_all(['div', 'p']):
            if not tag.get_text(strip=True):
                tag.decompose()
        return soup
