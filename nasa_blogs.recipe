import re, datetime
from calibre.web.feeds.news import BasicNewsRecipe

try:
    from deep_translator import GoogleTranslator
    translator = GoogleTranslator(source='en', target='zh-CN')
    CAN_TRANSLATE = True
except ImportError:
    CAN_TRANSLATE = False

class NasaRSSChineseRecipe(BasicNewsRecipe):
    title = f'NASA 新闻精选 - {datetime.datetime.now().strftime("%Y-%m-%d")}'
    language = 'zh-CN'
    oldest_article = 7
    max_articles_per_feed = 10
    auto_cleanup = True
    no_stylesheets = True

    keep_only_tags = [
        dict(name='h1'),
        dict(name='div', attrs={'class': re.compile(r'entry-content|field-content|text-content')}),
    ]

    remove_tags = [
        dict(name='aside'), dict(name='nav'), dict(name='footer'),
        dict(name='script'), dict(name='style'),
        dict(name='div', attrs={'class': re.compile(r'share|meta|related|tags|sidebar|comments')}),
    ]

    # 🚀 直接使用 NASA 官方 RSS Feed
    feeds = [
        ('NASA 新闻', 'https://www.nasa.gov/news-release/feed/'),
        ('NASA 博客', 'https://www.nasa.gov/blogs/feed/'),
    ]

    def postprocess_html(self, soup, first_fetch):
        """翻译为简体中文"""
        if not CAN_TRANSLATE:
            return soup

        # 找到正文容器
        containers = soup.find_all(['div', 'article'], 
                                   class_=re.compile(r'entry-content|field-content|text-content|node__content'))
        if not containers:
            containers = [soup.body] if soup.body else [soup]

        for container in containers:
            paragraphs = container.find_all(['p', 'h2', 'h3', 'li'])
            for p in paragraphs:
                text = p.get_text(strip=True)
                if len(text) < 20 or not re.search(r'[a-zA-Z]{3,}', text):
                    continue
                try:
                    translated = translator.translate(text)
                    if translated and translated != text:
                        p.string = translated
                except Exception:
                    continue
        return soup
