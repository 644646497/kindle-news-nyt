    '''

    def parse_index(self):
        """手动解析RSS"""
        feeds = []
        rss_url = 'https://cn.nytimes.com/rss/'
        
        try:
            self.log.info(f'正在抓取: {rss_url}')
            headers = {
                'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36'
            }
            req = urllib.request.Request(rss_url, headers=headers)
            
            with urllib.request.urlopen(req, timeout=30) as response:
                rss_content = response.read().decode('utf-8')
            
            # 清理可能存在的非法XML字符
            rss_content = re.sub(r'[^\x09\x0A\x0D\x20-\uD7FF\uE000-\uFFFD]', '', rss_content)
            
            root = ET.fromstring(rss_content)
            
            # 获取所有 item
            items = []
            for child in root.iter():
                if child.tag.endswith('item'):
                    items.append(child)
            
            articles = []
            seen_urls = set()
            
            for item in items:
                title_elem = None
                link_elem = None
                pubDate_elem = None
                description_elem = None
                
                for child in item:
                    tag_name = child.tag.split('}')[-1] if '}' in child.tag else child.tag
                    if tag_name == 'title':
                        title_elem = child
                    elif tag_name == 'link':
                        link_elem = child
                    elif tag_name == 'pubDate':
                        pubDate_elem = child
                    elif tag_name == 'description':
                        description_elem = child
                
                if title_elem is None or link_elem is None:
                    continue
                
                # 清理标题
                title = title_elem.text.strip() if title_elem.text else ''
                # 移除HTML实体和多余空白
                title = unescape(title)
                title = re.sub(r'\s+', ' ', title).strip()
                # 移除首尾的引号或特殊字符
                title = re.sub(r'^["\']+|["\']+$', '', title)
                
                url = link_elem.text.strip() if link_elem.text else ''
                
                # 获取日期
                date = ''
                if pubDate_elem is not None and pubDate_elem.text:
                    date = pubDate_elem.text.strip()
                
                # 获取描述
                description = ''
                if description_elem is not None and description_elem.text:
                    description = unescape(description_elem.text.strip())
                    # 移除HTML标签
                    description = re.sub(r'<[^>]+>', '', description)
                
                if not title or not url:
                    continue
                
                # 确保URL是完整的
                if url.startswith('/'):
                    url = 'https://cn.nytimes.com' + url
                elif not url.startswith('http'):
                    url = 'https://cn.nytimes.com/' + url.lstrip('/')
                
                if url in seen_urls:
                    continue
                
                seen_urls.add(url)
                
                # 调试：打印标题看是否正常
                self.log.info(f'抓取文章: {title[:50]}...')
                
                # 使用标准格式
                articles.append({
                    'title': title,
                    'url': url,
                    'link': url,
                    'date': date,
                    'description': description
                })
                
                if len(articles) >= self.max_articles_per_feed:
                    break
            
            if articles:
                feeds.append(('纽约时报中文网', articles))
                self.log.info(f'✅ 成功抓取 {len(articles)} 篇文章')
                # 打印前5个标题用于调试
                titles = [a['title'] for a in articles[:5]]
                self.log.info(f'前5篇文章标题: {titles}')
            else:
                self.log.warning('⚠️ 没有抓取到任何文章')
        
        except ET.ParseError as e:
            self.log.error(f'❌ RSS解析失败: {e}')
            self.log.error('尝试使用备用解析方法...')
            # 可以在这里添加备用解析方法
        except Exception as e:
            self.log.error(f'❌ 抓取RSS失败: {e}')
            import traceback
            traceback.print_exc()
        
        return feeds

    def preprocess_html(self, soup):
        """预处理HTML，清理和修复内容"""
        # 移除不需要的元素
        for tag in soup.find_all(['script', 'style', 'iframe', 'nav', 'header', 'footer', 'aside', 'form']):
            tag.decompose()
        
        # 移除广告相关元素
        for tag in soup.find_all(['div', 'section'], class_=re.compile(r'ad|advertisement|sponsor|promo|banner|social|share|comment|related', re.I)):
            tag.decompose()
        
        # 查找文章标题并确保显示
        title_selectors = [
            'h1.article-title',
            'h1.article-headline',
            'h1.headline',
            'h1.title',
            '.article-header h1',
            '.story-header h1',
            'header h1'
        ]
        
        for selector in title_selectors:
            try:
                title_elem = soup.select_one(selector)
                if title_elem:
                    # 确保标题元素可见
                    title_elem.name = 'h1'
                    title_elem['class'] = 'article-title'
                    break
            except:
                continue
        
        # 查找文章内容
        content_selectors = [
            '.article-body',
            '.story-body',
            '.article-content',
            '.story-content',
            '.article-text',
            '.content',
            'article'
        ]
        
        content_elem = None
        for selector in content_selectors:
            try:
                content_elem = soup.select_one(selector)
                if content_elem:
                    break
            except:
                continue
        
        # 如果找到内容，提取并清理
        if content_elem:
            # 移除内容中的广告
            for tag in content_elem.find_all(['div', 'section'], class_=re.compile(r'ad|advertisement|sponsor|promo', re.I)):
                tag.decompose()
            
            # 修复图片
            for img in content_elem.find_all('img'):
                if img.get('data-src') and not img.get('src'):
                    img['src'] = img['data-src']
                elif img.get('data-srcset') and not img.get('src'):
                    # 从srcset中提取第一个URL
                    srcset = img.get('data-srcset', '')
                    if srcset:
                        first_url = srcset.split(',')[0].strip().split(' ')[0]
                        img['src'] = first_url
        
        return soup

    def get_article_url(self, article):
        """获取文章URL"""
        if isinstance(article, dict):
            return article.get('url') or article.get('link')
        return None

    def get_article_title(self, article):
        """获取文章标题"""
        if isinstance(article, dict):
            title = article.get('title', '')
            # 清理标题
            title = unescape(title)
            title = re.sub(r'\s+', ' ', title).strip()
            return title
        return ''

    def postprocess_html(self, soup, first_fetch):
        """后处理HTML"""
        # 添加文章元数据
        meta_div = soup.new_tag('div')
        meta_div['class'] = 'article-meta'
        
        # 如果有日期信息，添加日期
        date_elem = soup.find('time')
        if date_elem:
            meta_div.append('发布时间: ')
            meta_div.append(date_elem)
        elif soup.find(class_=re.compile(r'date|time|published', re.I)):
            date_text = soup.find(class_=re.compile(r'date|time|published', re.I))
            if date_text:
                meta_div.append('发布时间: ')
                meta_div.append(date_text.get_text())
        
        # 在标题后插入元数据
        title_elem = soup.find('h1', class_='article-title')
        if title_elem:
            title_elem.insert_after(meta_div)
        
        return soup