def ensure_chinese_font():
    font_paths = [
        "/usr/share/fonts/truetype/noto/NotoSansCJK-Regular.ttc",
        "/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc",
        "/usr/share/fonts/truetype/noto/NotoSansCJK-Regular.ttf",
        "/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttf"
    ]
    for path in font_paths:
        if os.path.exists(path):
            return path
    print(">>> 未检测到中文字体，正在尝试安装...")
    try:
        subprocess.run(["sudo", "apt-get", "update"], check=True, capture_output=True)
        subprocess.run(["sudo", "apt-get", "install", "-y", "fonts-noto-cjk"], check=True, capture_output=True)
        subprocess.run(["fc-cache", "-f"], check=True, capture_output=True)
        for path in font_paths:
            if os.path.exists(path):
                return path
    except Exception as e:
        print(f">>> 安装字体失败: {e}")
    return None

FONT_PATH = ensure_chinese_font()

class NytimesRecipe(BasicNewsRecipe):
    title = '纽约时报中文网 - ' + datetime.datetime.now().strftime('%Y-%m-%d')
    language = 'zh-CN'
    oldest_article = 1
    max_articles_per_feed = 25
    auto_cleanup = True
    remove_javascript = True
    compress_news_images = True
    scale_news_images_to = 600
    
    # 存储当前文章标题
    current_title = ''
    
    remove_tags = [
        dict(name='script'), 
        dict(name='style'), 
        dict(name='iframe'),
        dict(name='nav'), 
        dict(name='header'), 
        dict(name='footer'), 
        dict(name='aside'), 
        dict(name='form'),
        dict(name='div', attrs={'class': re.compile(r'ad|advertisement|sponsor|promo|banner|social|share|comment|related', re.I)}),
        dict(name='div', attrs={'id': re.compile(r'ad|advertisement|sponsor|promo|banner|social|share|comment|related', re.I)}),
    ]

    extra_css = '''
        body { 
            font-family: "Noto Sans CJK SC", "PingFang SC", "Microsoft YaHei", sans-serif;
            line-height: 1.8;
            font-size: 16px;
