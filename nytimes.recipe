try:
    from opencc import OpenCC
    cc = OpenCC('t2s')
    CAN_CONVERT = True
except ImportError:
    CAN_CONVERT = False

# --- 1. 环境初始化：自动安装中文字体 ---
def ensure_chinese_font():
    font_paths = [
        "/usr/share/fonts/truetype/noto/NotoSansCJK-Regular.ttc",
        "/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc"
    ]

    for path in font_paths:
        if os.path.exists(path):
            return path

    print(">>> 未检测到中文字体，正在尝试安装...")
    try:
        subprocess.run(["sudo", "apt-get", "update"], check=True, capture_output=True)
        subprocess.run(["sudo", "apt-get", "install", "-y", "fonts-noto-cjk"], check=True, capture_output=True)
        subprocess.run(["fc-cache", "-f"], check=True, capture_output=True)
        for path in font_paths:
            if os.path.exists(path):
                return path
    except Exception as e:
        print(f">>> 安装字体失败: {e}")

    return None

FONT_PATH = ensure_chinese_font()

class NytimesRecipe(BasicNewsRecipe):
    title = '纽约时报中文网 - ' + datetime.datetime.now().strftime('%Y-%m-%d')
    language = 'zh-CN'
    oldest_article = 1
    max_articles_per_feed = 30
    auto_cleanup = True
    no_stylesheets = False
    remove_javascript = True
    compress_news_images = True
    scale_news_images_to = 600

    keep_only_tags = [
        dict(name='h1'),
        dict(name='article', attrs={'class': re.compile(r'article-content')}),
        dict(name='div', attrs={'class': re.compile(r'article-body|article-content|story-body|entry-content|post-content|main-content')}),
        dict(name='div', attrs={'class': re.compile(r'content|main', re.I)}),
        dict(name='article'),
        dict(name='main'),
        dict(name='div', attrs={'id': re.compile(r'content|article|main', re.I)}),
    ]

    remove_tags = [
        # 移除脚本和样式
        dict(name='script'), dict(name='style'), dict(name='iframe'),
        # 移除导航和页脚
        dict(name='nav'), dict(name='header'), dict(name='footer'),
        dict(name='aside'),
        # 移除广告和社交媒体
        dict(name='div', attrs={'class': re.compile(r'ad|advertisement|sponsor|promo|banner', re.I)}),
        dict(name='div', attrs={'id': re.compile(r'ad|advertisement|sponsor|promo|banner', re.I)}),
        # 移除分享按钮
        dict(name='div', attrs={'class': re.compile(r'share|social|twitter|facebook|wechat|weibo', re.I)}),
        dict(name='div', attrs={'id': re.compile(r'share|social|twitter|facebook|wechat|weibo', re.I)}),
        # 移除相关文章推荐
        dict(name='div', attrs={'class': re.compile(r'related|recommend|suggestion|more|popular|trending', re.I)}),
        dict(name='div', attrs={'id': re.compile(r'related|recommend|suggestion|more|popular|trending', re.I)}),
        dict(name='section', attrs={'class': re.compile(r'related|recommend|suggestion|more|popular|trending', re.I)}),
        # 移除评论
        dict(name='div', attrs={'class': re.compile(r'comment|discussion|response', re.I)}),
        dict(name='div', attrs={'id': re.compile(r'comment|discussion|response', re.I)}),
        # 移除标签和元数据
        dict(name='div', attrs={'class': re.compile(r'tag|meta|copyright|disclaimer', re.I)}),
        dict(name='div', attrs={'id': re.compile(r'tag|meta|copyright|disclaimer', re.I)}),
        # 移除订阅和新闻简报
        dict(name='div', attrs={'class': re.compile(r'newsletter|subscribe|signup|email', re.I)}),
        dict(name='div', attrs={'id': re.compile(r'newsletter|subscribe|signup|email', re.I)}),
        # 移除作者信息（保留在文章开头即可）
        dict(name='div', attrs={'class': re.compile(r'byline|author|bio|credit', re.I)}),
        # 移除列表中的额外文章
        dict(name='ul', attrs={'class': re.compile(r'related|recommend', re.I)}),
        dict(name='ol', attrs={'class': re.compile(r'related|recommend', re.I)}),
        # 移除下载信息
        dict(name='div', attrs={'class': re.compile(r'download|powered|calibre', re.I)}),
    ]

    # CSS 样式
    extra_css = '''
        body { 
            font-family: "Noto Sans CJK SC", "PingFang SC", "Microsoft YaHei", sans-serif;
            line-height: 1.8;
            font-size: 16px;
            color: #333;
            max-width: 700px;
            margin: 0 auto;
            padding: 20px;
        }
        h1 { 
            font-size: 24px; 
            font-weight: bold; 
            margin: 20px 0 10px 0;
            color: #1a1a2e;
            line-height: 1.4;
        }
        h2 { 
            font-size: 20px; 
            font-weight: bold; 
            margin: 15px 0 8px 0;
            color: #2d2d44;
        }
        p { 
            margin: 10px 0; 
            text-indent: 2em;
            text-align: justify;
        }
        img {
            max-width: 100%;
            height: auto;
            display: block;
            margin: 10px auto;
        }
        .article-content {
            padding: 10px 0;
