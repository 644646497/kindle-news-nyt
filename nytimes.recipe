#!/usr/bin/env python
# vim:fileencoding=utf-8
from __future__ import unicode_literals, division, absolute_import, print_function
import re
import datetime
import os
import subprocess
from io import BytesIO
from PIL import Image, ImageDraw, ImageFont
from calibre.web.feeds.news import BasicNewsRecipe

try:
    from opencc import OpenCC
    cc = OpenCC('t2s')
    CAN_CONVERT = True
except ImportError:
    CAN_CONVERT = False

# --- 1. 环境初始化：自动安装中文字体 ---
def ensure_chinese_font():
    font_paths = [
        "/usr/share/fonts/truetype/noto/NotoSansCJK-Regular.ttc",
        "/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc"
    ]

    for path in font_paths:
        if os.path.exists(path):
            return path

    print(">>> 未检测到中文字体，正在尝试安装...")
    try:
        subprocess.run(["sudo", "apt-get", "update"], check=True, capture_output=True)
        subprocess.run(["sudo", "apt-get", "install", "-y", "fonts-noto-cjk"], check=True, capture_output=True)
        subprocess.run(["fc-cache", "-f"], check=True, capture_output=True)
        for path in font_paths:
            if os.path.exists(path):
                return path
    except Exception as e:
        print(f">>> 安装字体失败: {e}")

    return None

FONT_PATH = ensure_chinese_font()

class NytimesRecipe(BasicNewsRecipe):
    title = '纽约时报中文网 - ' + datetime.datetime.now().strftime('%Y-%m-%d')
    language = 'zh-CN'
    oldest_article = 1
    max_articles_per_feed = 25
    auto_cleanup = True
    remove_javascript = True
    compress_news_images = True
    scale_news_images_to = 600
    
    # 使用 feeds 属性代替 parse_index，让 Calibre 自动处理 RSS
    feeds = [
        ('纽约时报中文网', 'https://cn.nytimes.com/rss/')
    ]
    
    # 更精确的内容提取
    keep_only_tags = [
        dict(name='article'),
        dict(name='div', attrs={'class': re.compile(r'content|article|story|post|entry', re.I)}),
    ]
    
    # 移除广告和干扰元素
    remove_tags = [
        dict(name='script'), dict(name='style'), dict(name='iframe'),
        dict(name='nav'), dict(name='header'), dict(name='footer'), 
        dict(name='aside'), dict(name='form'),
        dict(name='div', attrs={'class': re.compile(r'ad|advertisement|sponsor|promo|banner|social|share', re.I)}),
        dict(name='div', attrs={'id': re.compile(r'ad|advertisement|sponsor|promo|banner|social|share', re.I)}),
    ]

    extra_css = '''
        body { 
            font-family: "Noto Sans CJK SC", "PingFang SC", "Microsoft YaHei", sans-serif;
            line-height: 1.8;
            font-size: 16px;
            color: #333;
            max-width: 700px;
            margin: 0 auto;
            padding: 20px;
        }
        h1 { 
            font-size: 24px; 
            font-weight: bold; 
            margin: 20px 0 10px 0;
            color: #1a1a2e;
            line-height: 1.4;
        }
        p { 
            margin: 10px 0; 
            text-indent: 2em;
            text-align: justify;
        }
        img {
            max-width: 100%;
            height: auto;
            display: block;
            margin: 10px auto;
        }
        .article-content { padding: 10px 0; }
        blockquote {
            border-left: 4px solid #e94560;
            padding-left: 20px;
            margin-left: 20px;
            color: #555;
        }
    '''

    def preprocess_html(self, soup):
        """预处理：修复图片链接"""
        for img in soup.find_all('img'):
            src = img.get('data-src') or img.get('src', '')
            if src:
                if src.startswith('//'):
                    src = 'https:' + src
                elif src.startswith('/') and not src.startswith('//'):
                    src = 'https://cn.nytimes.com' + src
                img['src'] = src
        
        # 移除包含 "推荐阅读" 的容器
        for div in soup.find_all(['div', 'section', 'ul']):
            text = div.get_text()
            if any(k in text for k in ['推荐阅读', '相关文章', '热门文章', '更多文章', '你可能感兴趣']):
                div.decompose()
        
        return soup

    def postprocess_html(self, soup, first_fetch):
        """后处理：简繁转换 + 清理推荐列表"""
        
        # 简繁转换
        if CAN_CONVERT:
            for elem in soup.find_all(string=True):
                text = str(elem)
                if len(text) > 3 and elem.parent.name not in ['script', 'style']:
                    try:
                        converted = cc.convert(text)
                        if converted != text:
                            elem.replace_with(converted)
                    except:
                        pass
        
        # 移除所有包含 "推荐" 或 "related" 的容器
        for tag in soup.find_all(['div', 'section', 'ul', 'ol', 'aside']):
            classes = ' '.join(tag.get('class', [])).lower()
            tag_id = tag.get('id', '').lower()
            
            if any(k in classes or k in tag_id for k in [
                'related', 'recommend', 'suggestion', 'popular', 
                'trending', 'most-read', 'more-news'
            ]):
                tag.decompose()
                continue
            
            # 检查文本内容
            text = tag.get_text()
            if any(k in text for k in ['推荐阅读', '相关文章', '热门文章', '更多文章']):
                tag.decompose()
        
        # 移除文章末尾可能存在的推荐列表
        # 找到最后一个段落后面的容器
        paragraphs = soup.find_all('p')
        if paragraphs:
            last_p = paragraphs[-1]
            # 检查后续兄弟元素
            for sibling in last_p.find_next_siblings():
                if sibling.name in ['div', 'section', 'ul', 'ol']:
                    links = sibling.find_all('a')
                    # 如果有3个以上链接，很可能是推荐列表
                    if len(links) >= 3:
                        sibling.decompose()
        
        return soup

    def get_cover_url(self):
        """生成封面"""
        try:
            width, height = 600, 800
            img = Image.new('RGB', (width, height), color='#1a1a2e')
            draw = ImageDraw.Draw(img)
            
            font_path = FONT_PATH
            try:
                if font_path and os.path.exists(font_path):
                    font_large = ImageFont.truetype(font_path, 72)
                    font_medium = ImageFont.truetype(font_path, 36)
                    font_small = ImageFont.truetype(font_path, 28)
                else:
                    font_large = font_medium = font_small = ImageFont.load_default()
            except:
                font_large = font_medium = font_small = ImageFont.load_default()
            
            # 装饰线
            draw.rectangle([(50, 200), (550, 205)], fill='#e94560')
            
            # 标题
            title = '纽约时报'
            subtitle = '中文网'
            date_str = datetime.datetime.now().strftime('%Y年%m月%d日')
            
            # 居中绘制
            bbox = draw.textbbox((0, 0), title, font=font_large)
            tw = bbox[2] - bbox[0]
            draw.text(((width - tw) // 2, 250), title, fill='#ffffff', font=font_large)
            
            bbox = draw.textbbox((0, 0), subtitle, font=font_medium)
            sw = bbox[2] - bbox[0]
            draw.text(((width - sw) // 2, 340), subtitle, fill='#e94560', font=font_medium)
            
            bbox = draw.textbbox((0, 0), date_str, font=font_small)
            dw = bbox[2] - bbox[0]
            draw.text(((width - dw) // 2, 450), date_str, fill='#ffffff', font=font_small)
            
            cover_bytes = BytesIO()
            img.save(cover_bytes, 'JPEG', quality=85)
            cover_bytes.seek(0)
            return cover_bytes.getvalue()
            
        except Exception as e:
            self.log.error(f'封面生成失败: {e}')
            return None