try:
    from opencc import OpenCC
    cc = OpenCC('t2s')
    CAN_CONVERT = True
except ImportError:
    CAN_CONVERT = False

# --- 1. 环境初始化：自动安装中文字体 ---
def ensure_chinese_font():
    font_paths = [
        "/usr/share/fonts/truetype/noto/NotoSansCJK-Regular.ttc",
        "/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc"
    ]

    for path in font_paths:
        if os.path.exists(path):
            return path

    print(">>> 未检测到中文字体，正在尝试安装...")
    try:
        subprocess.run(["sudo", "apt-get", "update"], check=True, capture_output=True)
        subprocess.run(["sudo", "apt-get", "install", "-y", "fonts-noto-cjk"], check=True, capture_output=True)
        subprocess.run(["fc-cache", "-f"], check=True, capture_output=True)
        for path in font_paths:
            if os.path.exists(path):
                return path
    except Exception as e:
        print(f">>> 安装字体失败: {e}")

    return None

FONT_PATH = ensure_chinese_font()

class NytimesRecipe(BasicNewsRecipe):
    title = '纽约时报中文网 - ' + datetime.datetime.now().strftime('%Y-%m-%d')
    language = 'zh-CN'
    oldest_article = 1
    max_articles_per_feed = 30
    auto_cleanup = True
    no_stylesheets = False
    remove_javascript = True
    compress_news_images = True
    scale_news_images_to = 600
    
    # 不使用 keep_only_tags，改为在预处理中精确提取
    no_stylesheets = True

    remove_tags = [
        dict(name='script'), dict(name='style'), dict(name='iframe'),
        dict(name='nav'), dict(name='header'), dict(name='footer'),
        dict(name='aside'),
        dict(name='form'), dict(name='input'),
    ]

    extra_css = '''
        body { 
            font-family: "Noto Sans CJK SC", "PingFang SC", "Microsoft YaHei", sans-serif;
            line-height: 1.8;
            font-size: 16px;
            color: #333;
            max-width: 700px;
            margin: 0 auto;
            padding: 20px;
        }
        h1 { 
            font-size: 24px; 
            font-weight: bold; 
            margin: 20px 0 10px 0;
            color: #1a1a2e;
            line-height: 1.4;
        }
        h2 { 
            font-size: 20px; 
            font-weight: bold; 
            margin: 15px 0 8px 0;
            color: #2d2d44;
        }
        h3, h4 { 
            font-size: 18px; 
            font-weight: bold; 
            margin: 12px 0 6px 0;
            color: #2d2d44;
        }
        p { 
            margin: 10px 0; 
            text-indent: 2em;
            text-align: justify;
        }
        img {
            max-width: 100%;
            height: auto;
            display: block;
            margin: 10px auto;
        }
        .article-content {
            padding: 10px 0;
        }
        blockquote {
            border-left: 4px solid #e94560;
            padding-left: 20px;
            margin-left: 20px;
            color: #555;
        }
        .article-meta {
            color: #666;
            font-size: 14px;
            margin: 10px 0;
        }
    '''

    def parse_index(self):
        feeds = []
        sections = [
            ('纽约时报中文网', 'https://cn.nytimes.com/rss/'),
        ]

        for section_name, section_url in sections:
            try:
                self.log.info(f'正在抓取: {section_url}')
                
                headers = {'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36'}
                req = urllib.request.Request(section_url, headers=headers)
                
                with urllib.request.urlopen(req, timeout=30) as response:
                    rss_content = response.read().decode('utf-8')
                
                root = ET.fromstring(rss_content)
                
                items = []
                for child in root.iter():
                    if child.tag.endswith('item'):
                        items.append(child)
                
                if not items:
                    items = root.findall('.//item')
                
                articles = []
                seen_urls = set()
                
                for item in items:
                    title_elem = None
                    link_elem = None
                    
                    for child in item:
                        tag_name = child.tag.split('}')[-1] if '}' in child.tag else child.tag
                        if tag_name == 'title':
                            title_elem = child
                        elif tag_name == 'link':
                            link_elem = child
                    
                    if title_elem is None or link_elem is None:
                        continue
                    
                    title = title_elem.text
                    url = link_elem.text
                    
                    if not title or not url:
                        continue
                    
                    title = title.strip()
                    url = url.strip()
                    
                    if len(title) < 10:
                        continue
                    
                    if url in seen_urls:
                        continue
                    
                    seen_urls.add(url)
                    
                    articles.append({
                        'title': title,
                        'url': url,
                        'date': '',
                        'description': ''
                    })
                    
                    if len(articles) >= self.max_articles_per_feed:
                        break
                
                if articles:
                    feeds.append((section_name, articles))
                    self.log.info(f'✅ 成功抓取 {len(articles)} 篇文章')
                else:
                    self.log.warning(f'⚠️ 未抓到任何文章: {section_url}')
                        
            except Exception as e:
                self.log.error(f'❌ 解析RSS失败: {str(e)}')
                import traceback
                self.log.error(traceback.format_exc())

        return feeds

    def preprocess_html(self, soup):
        """预处理HTML：提取文章主体内容"""
        
        # 1. 修复图片链接
        for img in soup.find_all('img'):
            real_src = img.get('data-src') or img.get('data-original') or img.get('src', '')
            if real_src:
                if real_src.startswith('//'):
                    real_src = 'https:' + real_src
                elif real_src.startswith('/'):
                    real_src = 'https://cn.nytimes.com' + real_src
                img['src'] = real_src
        
        # 2. 移除无关元素
        for tag in soup.find_all(['script', 'style', 'iframe', 'nav', 'header', 'footer', 'aside', 'form']):
            tag.decompose()
        
        # 3. 查找文章主体 - 尝试多种可能的选择器
        article_body = None
        
        # 尝试常见的文章容器
        selectors = [
            ('div', {'class': re.compile(r'article-body|article-content|story-body|entry-content|post-content', re.I)}),
            ('div', {'class': re.compile(r'content|main-content', re.I)}),
            ('div', {'id': re.compile(r'article|content|main', re.I)}),
            ('article', {}),
            ('main', {}),
        ]
        
        for tag_name, attrs in selectors:
            if attrs:
                article_body = soup.find(tag_name, attrs=attrs)
            else:
                article_body = soup.find(tag_name)
            if article_body:
                break
        
        if article_body:
            # 只保留文章主体
            soup = article_body
        else:
            # 如果找不到，尝试提取所有段落
            self.log.warning('未找到标准文章容器，尝试提取段落')
            paragraphs = soup.find_all('p')
            if len(paragraphs) > 2:
                # 创建一个新的容器
                new_soup = BeautifulSoup('<div class="article-content"></div>', 'html.parser')
                container = new_soup.find('div')
                for p in paragraphs[:20]:  # 最多取20段
                    container.append(p)
                soup = new_soup
        
        # 4. 移除文章中的推荐列表（关键步骤）
        # 查找所有包含"推荐"或"related"的容器
        for div in soup.find_all(['div', 'section', 'ul', 'ol']):
            # 检查class和id
            class_str = ' '.join(div.get('class', [])).lower() if div.get('class') else ''
            id_str = div.get('id', '').lower()
            combined = class_str + ' ' + id_str
            
            # 移除包含这些关键词的元素
            if any(keyword in combined for keyword in [
                'recommend', 'related', 'suggestion', 'more-news', 
                'popular', 'trending', 'most-read', 'most-popular',
                'read-next', 'you-may-like', 'also-read',
                '推荐', '相关', '更多', '热门'
            ]):
                div.decompose()
                continue
            
            # 检查div内的文本
            div_text = div.get_text().strip()
            if any(keyword in div_text for keyword in ['更多文章', '相关推荐', '阅读更多', '其他新闻', '热门文章']):
                div.decompose()
                continue
        
        # 5. 移除包含多个链接和图片的容器（推荐文章列表的特征）
        for div in soup.find_all(['div', 'section']):
            links = div.find_all('a')
            images = div.find_all('img')
            
            # 如果有3个以上的链接和2个以上的图片，很可能是推荐列表
            if len(links) >= 3 and len(images) >= 2:
                # 检查链接文本长度
                long_links = [l for l in links if len(l.get_text(strip=True)) > 10]
                if len(long_links) >= 3:
                    div.decompose()
                    continue
            
            # 如果有4个以上的链接且没有段落文本，很可能是导航或列表
            if len(links) >= 4:
                paragraphs = div.find_all('p')
                if len(paragraphs) == 0:
                    div.decompose()
                    continue
        
        # 6. 移除文章末尾的"下载信息"
        for div in soup.find_all('div'):
            if div.string and 'downloaded by calibre' in str(div.string).lower():
                div.decompose()
        
        return soup

    def postprocess_html(self, soup, first_fetch):
        """后处理：简繁转换 + 最终清理"""
        
        # 1. 简繁转换
        if CAN_CONVERT:
            for element in soup.find_all(string=True):
                text = str(element)
                if len(text) > 3:
                    if element.parent and element.parent.name not in ['script', 'style']:
                        try:
                            converted = cc.convert(text)
                            if converted != text:
                                element.replace_with(converted)
                        except Exception:
                            pass
        
        # 2. 最终清理：移除空的或只有空格的元素
        for tag in soup.find_all():
            if tag.name in ['div', 'section', 'span']:
                if not tag.get_text(strip=True):
                    tag.decompose()
        
        # 3. 确保文章有标题
        if not soup.find('h1'):
            # 如果文章没有h1，尝试从其他地方获取
            title_tag = soup.find('title')
            if title_tag:
                title = title_tag.get_text(strip=True)
                # 移除网站名称等多余信息
                title = re.sub(r'\|.*$', '', title).strip()
                if title:
                    new_h1 = soup.new_tag('h1')
                    new_h1.string = title
                    soup.insert(0, new_h1)
        
        return soup

    def get_cover_url(self):
        """生成封面图片"""
        try:
            width, height = 600, 800
            background_color = '#1a1a2e'
            text_color = '#ffffff'
            accent_color = '#e94560'

            img = Image.new('RGB', (width, height), color=background_color)
            draw = ImageDraw.Draw(img)

            font_path = FONT_PATH
            
            try:
                if font_path and os.path.exists(font_path):
                    font_large = ImageFont.truetype(font_path, 72)
                    font_medium = ImageFont.truetype(font_path, 36)
                    font_small = ImageFont.truetype(font_path, 28)
                else:
                    font_large = ImageFont.load_default()
                    font_medium = ImageFont.load_default()
                    font_small = ImageFont.load_default()
            except:
                font_large = ImageFont.load_default()
                font_medium = ImageFont.load_default()
                font_small = ImageFont.load_default()

            draw.rectangle([(50, 200), (550, 205)], fill=accent_color)
            
            title_text = '纽约时报'
            subtitle_text = '中文网'
            date_text = datetime.datetime.now().strftime('%Y年%m月%d日')
            
            try:
                bbox = draw.textbbox((0, 0), title_text, font=font_large)
                title_width = bbox[2] - bbox[0]
                draw.text(((width - title_width) // 2, 250), title_text, fill=text_color, font=font_large)
                
                bbox = draw.textbbox((0, 0), subtitle_text, font=font_medium)
                sub_width = bbox[2] - bbox[0]
                draw.text(((width - sub_width) // 2, 340), subtitle_text, fill=accent_color, font=font_medium)
                
                bbox = draw.textbbox((0, 0), date_text, font=font_small)
                date_width = bbox[2] - bbox[0]
                draw.text(((width - date_width) // 2, 450), date_text, fill=text_color, font=font_small)
                
                footer_text = 'Kindle 推送版'
                bbox = draw.textbbox((0, 0), footer_text, font=font_small)
                footer_width = bbox[2] - bbox[0]
                draw.text(((width - footer_width) // 2, 700), footer_text, fill='#666666', font=font_small)
                
            except Exception as e:
                print(f'封面绘制错误: {e}')
                draw.text((50, 300), '纽约时报中文网', fill=text_color, font=font_large)
                draw.text((50, 400), date_text, fill=text_color, font=font_small)

            cover_bytes = BytesIO()
            img.save(cover_bytes, 'JPEG', quality=85)
            cover_bytes.seek(0)
            
            return cover_bytes.getvalue()
            
        except Exception as e:
            self.log.error(f'生成封面失败: {e}')
            return None