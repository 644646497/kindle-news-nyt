#!/usr/bin/env python
# vim:fileencoding=utf-8
from __future__ import unicode_literals, division, absolute_import, print_function
import re
import datetime
import time
import os
import subprocess
import urllib.request
import xml.etree.ElementTree as ET
from io import BytesIO
from PIL import Image, ImageDraw, ImageFont  # 统一在这里导入
from calibre.web.feeds.news import BasicNewsRecipe

try:
    from opencc import OpenCC
    cc = OpenCC('t2s')
    CAN_CONVERT = True
except ImportError:
    CAN_CONVERT = False

# --- 1. 环境初始化：自动安装中文字体 ---
def ensure_chinese_font():
    font_paths = [
        "/usr/share/fonts/truetype/noto/NotoSansCJK-Regular.ttc",
        "/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc"
    ]

    for path in font_paths:
        if os.path.exists(path):
            return path

    print(">>> 未检测到中文字体，正在尝试安装...")
    try:
        subprocess.run(["sudo", "apt-get", "update"], check=True, capture_output=True)
        subprocess.run(["sudo", "apt-get", "install", "-y", "fonts-noto-cjk"], check=True, capture_output=True)
        subprocess.run(["fc-cache", "-f"], check=True, capture_output=True)
        for path in font_paths:
            if os.path.exists(path):
                return path
    except Exception as e:
        print(f">>> 安装字体失败: {e}")

    return None

FONT_PATH = ensure_chinese_font()

class NytimesRecipe(BasicNewsRecipe):
    title = '纽约时报中文网 - ' + datetime.datetime.now().strftime('%Y-%m-%d')
    language = 'zh-CN'
    oldest_article = 1
    max_articles_per_feed = 30
    auto_cleanup = True
    no_stylesheets = False
    remove_javascript = True
    compress_news_images = True
    scale_news_images_to = 600

    keep_only_tags = [
        dict(name='h1'),
        dict(name='article', attrs={'class': re.compile(r'article-content')}),
        dict(name='div', attrs={'class': re.compile(r'article-body|article-content|story-body|entry-content|post-content')}),
        dict(name='div', attrs={'class': re.compile(r'content|main-content', re.I)}),
        dict(name='article'),
        dict(name='main'),
    ]

    remove_tags = [
        dict(name='script'), dict(name='style'), dict(name='iframe'),
        dict(name='nav'), dict(name='header'), dict(name='footer'),
        dict(name='aside'),
        dict(name='div', attrs={'class': re.compile(r'ad|share|related|comment|sidebar|tags|meta|social|popup|overlay|newsletter', re.I)}),
        dict(name='div', attrs={'id': re.compile(r'ad|share|related|comment|sidebar|tags|meta|social', re.I)}),
    ]

    def parse_index(self):
        """使用标准XML解析器解析RSS，避免命名空间问题"""
        feeds = []
        sections = [
            ('纽约时报中文网', 'https://cn.nytimes.com/rss/'),
        ]

        for section_name, section_url in sections:
            try:
                self.log.info(f'正在抓取: {section_url}')
                
                # 获取RSS内容
                headers = {'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36'}
                req = urllib.request.Request(section_url, headers=headers)
                
                with urllib.request.urlopen(req, timeout=30) as response:
                    rss_content = response.read().decode('utf-8')
                
                # 解析XML
                root = ET.fromstring(rss_content)
                
                # 查找所有item（兼容命名空间）
                items = []
                for child in root.iter():
                    if child.tag.endswith('item'):
                        items.append(child)
                
                if not items:
                    items = root.findall('.//item')
                
                articles = []
                seen_urls = set()
                
                for item in items:
                    title_elem = None
                    link_elem = None
                    
                    for child in item:
                        tag_name = child.tag.split('}')[-1] if '}' in child.tag else child.tag
                        if tag_name == 'title':
                            title_elem = child
                        elif tag_name == 'link':
                            link_elem = child
                    
                    if title_elem is None or link_elem is None:
                        continue
                    
                    title = title_elem.text
                    url = link_elem.text
                    
                    if not title or not url:
                        continue
                    
                    title = title.strip()
                    url = url.strip()
                    
                    if len(title) < 10:
                        continue
                    
                    if url in seen_urls:
                        continue
                    
                    seen_urls.add(url)
                    
                    articles.append({
                        'title': title,
                        'url': url,
                        'date': '',
                        'description': ''
                    })
                    
                    if len(articles) >= self.max_articles_per_feed:
                        break
                
                if articles:
                    feeds.append((section_name, articles))
                    self.log.info(f'✅ 成功抓取 {len(articles)} 篇文章')
                else:
                    self.log.warning(f'⚠️ 未抓到任何文章: {section_url}')
                        
            except Exception as e:
                self.log.error(f'❌ 解析RSS失败: {str(e)}')
                import traceback
                self.log.error(traceback.format_exc())

        return feeds

    def preprocess_html(self, soup):
        """预处理HTML：修复图片链接"""
        for img in soup.find_all('img'):
            real_src = img.get('data-src') or img.get('data-original') or img.get('src', '')
            if real_src:
                if real_src.startswith('//'):
                    real_src = 'https:' + real_src
                elif real_src.startswith('/'):
                    real_src = 'https://cn.nytimes.com' + real_src
                img['src'] = real_src
        
        for tag in soup.find_all('div', class_=re.compile(r'ad|share|social|promo', re.I)):
            tag.decompose()
        
        return soup

    def postprocess_html(self, soup, first_fetch):
        """后处理：简繁转换"""
        if CAN_CONVERT:
            for element in soup.find_all(string=True):
                text = str(element)
                if len(text) > 3:
                    if element.parent and element.parent.name not in ['script', 'style']:
                        try:
                            converted = cc.convert(text)
                            if converted != text:
                                element.replace_with(converted)
                        except Exception:
                            pass
        return soup

    def get_cover_url(self):
        """生成封面图片"""
        try:
            width, height = 600, 800
            background_color = '#1a1a2e'
            text_color = '#ffffff'
            accent_color = '#e94560'

            img = Image.new('RGB', (width, height), color=background_color)
            draw = ImageDraw.Draw(img)

            font_path = FONT_PATH
            
            # 设置字体
            try:
                if font_path and os.path.exists(font_path):
                    font_large = ImageFont.truetype(font_path, 72)
                    font_medium = ImageFont.truetype(font_path, 36)
                    font_small = ImageFont.truetype(font_path, 28)
                else:
                    font_large = ImageFont.load_default()
                    font_medium = ImageFont.load_default()
                    font_small = ImageFont.load_default()
            except:
                font_large = ImageFont.load_default()
                font_medium = ImageFont.load_default()
                font_small = ImageFont.load_default()

            # 绘制装饰线
            draw.rectangle([(50, 200), (550, 205)], fill=accent_color)
            
            # 绘制标题
            title_text = '纽约时报'
            subtitle_text = '中文网'
            date_text = datetime.datetime.now().strftime('%Y年%m月%d日')
            
            # 居中绘制标题
            try:
                bbox = draw.textbbox((0, 0), title_text, font=font_large)
                title_width = bbox[2] - bbox[0]
                draw.text(((width - title_width) // 2, 250), title_text, fill=text_color, font=font_large)
                
                bbox = draw.textbbox((0, 0), subtitle_text, font=font_medium)
                sub_width = bbox[2] - bbox[0]
                draw.text(((width - sub_width) // 2, 340), subtitle_text, fill=accent_color, font=font_medium)
                
                bbox = draw.textbbox((0, 0), date_text, font=font_small)
                date_width = bbox[2] - bbox[0]
                draw.text(((width - date_width) // 2, 450), date_text, fill=text_color, font=font_small)
                
                footer_text = 'Kindle 推送版'
                bbox = draw.textbbox((0, 0), footer_text, font=font_small)
                footer_width = bbox[2] - bbox[0]
                draw.text(((width - footer_width) // 2, 700), footer_text, fill='#666666', font=font_small)
                
            except Exception as e:
                print(f'封面绘制错误: {e}')
                # 备用方案：简单文本
                draw.text((50, 300), '纽约时报中文网', fill=text_color, font=font_large)
                draw.text((50, 400), date_text, fill=text_color, font=font_small)

            # 保存为字节流
            cover_bytes = BytesIO()
            img.save(cover_bytes, 'JPEG', quality=85)
            cover_bytes.seek(0)
            
            # 返回图片数据（作为 bytes）
            return cover_bytes.getvalue()
            
        except Exception as e:
            self.log.error(f'生成封面失败: {e}')
            return None

