    ]

    def parse_index(self):
        feeds = []
        # 同时定义联合报和科技新报的抓取源
        sections = [
            ('联合报 - 即时新闻', 'https://udn.com/news/breaknews/1/1'),
            ('科技新报 - 首页', 'https://technews.tw/')
        ]

        for section_name, section_url in sections:
            try:
                soup = self.index_to_soup(section_url)
                articles = []
                seen_urls = set()

                # 根据网站不同，使用不同的正则匹配新闻链接
                if 'technews.tw' in section_url:
                    link_pattern = re.compile(r'^/\d{4}/\d{2}/\d{2}/')
                else:
                    link_pattern = re.compile(r'/news/story/')

                for link in soup.find_all('a', href=link_pattern):
                    title = link.get_text(strip=True)
                    if title and len(title) > 5:
                        url = link.get('href')
                        if url.startswith('/'):
                            url = 'https://' + section_url.split('/')[2] + url
                        if url in seen_urls:
                            continue
                        seen_urls.add(url)
                        articles.append({'title': title, 'url': url, 'date': '', 'description': ''})
                    if len(articles) >= self.max_articles_per_feed:
                        break

                if articles:
                    feeds.append((section_name, articles))
            except Exception as e:
                self.log.error(f"抓取 {section_name} 失败: {e}")

        return feeds

    def preprocess_html(self, soup):
        for img in soup.find_all('img'):
            real_src = img.get('data-src') or img.get('data-original') or img.get('src', '')
            if real_src:
                if real_src.startswith('//'):
                    real_src = 'https:' + real_src
                elif real_src.startswith('/'):
                    real_src = 'https://technews.tw' + real_src
                img['src'] = real_src
        for tag in soup.find_all('div', class_=re.compile(r'ad|share|social', re.I)):
            tag.decompose()
        return soup

    def postprocess_html(self, soup, first_fetch):
        if CAN_CONVERT:
            for element in soup.find_all(string=True):
                text = str(element)
                if len(text) > 3:
                    if element.parent and element.parent.name not in ['script', 'style']:
                        try:
                            converted = cc.convert(text)
                            if converted != text:
                                element.replace_with(converted)
                        except:
                            pass
        return soup

