#!/usr/bin/env python
# -*- coding: utf-8 -*-
import requests
from opencc import OpenCC
from datetime import datetime, timezone
import xml.etree.ElementTree as ET

OUTPUT_FILE = "nikkei_feed.xml"
# 官方RSS地址
RSS_SOURCE = "https://cn.nikkei.com/rss/news.rss"

# 繁简转换
try:
    cc = OpenCC("t2s")
except:
    class FakeCC:
        def convert(self, x):
            return x
    cc = FakeCC()

# XML转义
def escape_xml(text):
    if not text:
        return ""
    s = str(text)
    s = s.replace('&','&amp;').replace('<','&lt;').replace('>','&gt;')
    s = s.replace('"','&quot;').replace("'",'&apos;')
    return s

# 拉取官方RSS并简体化
def build_rss():
    resp = requests.get(RSS_SOURCE, timeout=20)
    root = ET.fromstring(resp.content)
    ns = {"rss": "http://purl.org/rss/1.0/modules/content/"}
    items_xml = ""
    build_time = datetime.now(timezone.utc).strftime("%a, %d %b %Y %H:%M:%S GMT")
    for item in root.findall(".//item"):
        title = cc.convert(item.find("title").text or "")
        link = item.find("link").text or ""
        desc_raw = item.find("description").text or ""
        desc = cc.convert(desc_raw).replace("]]>", "]]&gt;")
        pubdate = item.find("pubDate").text or build_time
        item_str = f"""
<item>
<title>{escape_xml(title)}</title>
<link>{escape_xml(link)}</link>
<description><![CDATA[{desc}]]></description>
<pubDate>{pubdate}</pubDate>
</item>
"""
        items_xml += item_str
    final_xml = f"""<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0">
<channel>
<title>日经中文网（简体）</title>
<link>https://cn.nikkei.com</link>
<description>日经官方RSS自动转简体，适配Kindle推送</description>
<lastBuildDate>{build_time}</lastBuild>
{items_xml}
</channel>
</rss>
"""
    with open(OUTPUT_FILE, "w", encoding="utf-8") as f:
        f.write(final_xml)
    print("✅ 官方RSS转换完成")

if __name__ == "__main__":
    build_rss()
