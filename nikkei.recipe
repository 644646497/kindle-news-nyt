import os
import time
import re
import datetime
from calibre.web.feeds.news import BasicNewsRecipe

os.environ['TZ'] = 'Asia/Shanghai'
time.tzset()

class AdvancedUserRecipe1281929028(BasicNewsRecipe):
    title = datetime.datetime.now().strftime('日经新闻 - %Y-%m-%d %H-%M')
    language = 'zh_CN'
    oldest_article = 1
    max_articles_per_feed = 15
    
    no_summaries = True
    use_embedded_content = True
    
    remove_tags = [
        dict(name='hr'),
        dict(name='script'),
        dict(name='style'),
    ]
    
    def preprocess_html(self, soup):
        # 移除RSS推广链接
        for a in soup.find_all('a'):
            if 'feedx' in a.get('href', ''):
                a.decompose()
        for div in soup.find_all('div'):
            if '获取更多RSS' in div.get_text():
                div.decompose()
        return soup
    
    # 使用日经官方RSS
    feeds = [
        ('日经中文网', 'https://www.nikkei.com/rss/News/index.rss'),
    ]