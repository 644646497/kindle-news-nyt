from calibre.web.feeds.news import BasicNewsRecipe
import os
import time
import re
import datetime

os.environ['TZ'] = 'Asia/Shanghai'
time.tzset()

class NikkeiRecipe(BasicNewsRecipe):
    title = datetime.datetime.now().strftime('日经中文网 - %Y-%m-%d')
    language = 'zh_CN'
    oldest_article = 1
    max_articles_per_feed = 10
    
    no_summaries = True
    use_embedded_content = True
    
    remove_tags = [
        dict(name='hr'),
        dict(name='script'),
        dict(name='style'),
        dict(name='div', attrs={'class': ['ad', 'banner', 'related', 'share', 'recommend', 'header', 'footer', 'nav', 'sidebar']}),
    ]
    
    def preprocess_html(self, soup):
        for a in soup.find_all('a', href=re.compile(r'.*feedx.*')):
            a.decompose()
        for div in soup.find_all('div'):
            if '获取更多RSS' in div.get_text():
                div.decompose()
        return soup
    
    feeds = [
        ('日经中文', 'https://raw.githubusercontent.com/644646497/rs/main/feed.xml'),
    ]
