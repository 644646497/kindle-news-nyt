#!/usr/bin/env python
# vim:fileencoding=utf-8
from __future__ import unicode_literals, division, absolute_import, print_function
import re
import datetime
import os
import urllib.request
from io import BytesIO
from PIL import Image, ImageDraw, ImageFont
from calibre.web.feeds.news import BasicNewsRecipe

class NikkeiRecipe(BasicNewsRecipe):
    title = '日经中文网 ' + datetime.datetime.now().strftime('%Y-%m-%d')
    language = 'zh-CN'
    max_articles_per_feed = 40
    oldest_article = 2
    auto_cleanup = True
    remove_javascript = True
    compress_news_images = True
    # 自动清理多余广告标签
    remove_tags = [dict(class_=['ad', 'banner', 'recommend', 'related_box'])]

    extra_css = '''
        body { font-family: "Noto Sans CJK SC", sans-serif; line-height: 1.8; font-size: 16px; }
        h1 { font-size: 24px; margin: 20px 0; }
        p { text-indent: 2em; text-align: justify; }
        img { max-width: 100%; height: auto; display: block; margin: 15px auto; }
    '''

    def parse_index(self):
        articles = []
        seen = set()
        
        urls = [
            'https://cn.nikkei.com/',
            'https://cn.nikkei.com/china/',
            'https://cn.nikkei.com/politicsaeconomy/',
            'https://cn.nikkei.com/industry/',
        ]
        
        headers = {
            'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36'
        }
        # 更新正则：适配当前日经链接 /xxx/2026-07-20-xxxx.html
        pattern = re.compile(r'href="(/[^"]*?/\d{4}-\d{2}-\d{2}-\d+\.html)"[^>]*>([^<]+)</a>', re.I)

        for base_url in urls:
            try:
                req = urllib.request.Request(base_url, headers=headers)
                with urllib.request.urlopen(req, timeout=20) as resp:
                    html = resp.read().decode('utf-8', errors='ignore')
                
                for match in pattern.findall(html):
                    url_suffix, title = match
                    title = re.sub(r'\s+', ' ', title.strip())
                    
                    # 过滤导航、无用链接
                    if len(title) < 10 or any(k in title for k in ['首页','搜索','登录','注册','订阅','广告']):
                        continue
                    
                    full_url = 'https://cn.nikkei.com' + url_suffix
                    if full_url in seen:
                        continue
                    seen.add(full_url)
                    
                    articles.append({
                        'title': title,
                        'url': full_url,
                        'description': '',
                        'date': datetime.datetime.now()
                    })
                    
                    if len(articles) >= self.max_articles_per_feed:
                        break
            except Exception as e:
                self.log.error(f'抓取栏目失败 {base_url}: {str(e)}')
        
        self.log.info(f'本次共抓取有效文章 {len(articles)} 篇')
        return [('日经中文网资讯', articles)]

    def preprocess_html(self, soup):
        # 补全相对图片地址
        for img in soup.find_all('img'):
            src = img.get('data-src') or img.get('src')
            if src and src.startswith('/'):
                img['src'] = f'https://cn.nikkei.com{src}'
        return soup

    def get_cover_url(self):
        try:
            width, height = 600, 800
            img = Image.new('RGB', (width, height), color='#1a1a2e')
            draw = ImageDraw.Draw(img)
            # 加载系统中文字体兜底
            try:
                font_big = ImageFont.truetype("/usr/share/fonts/noto-cjk/NotoSansCJK-Regular.ttc", 48)
                font_small = ImageFont.truetype("/usr/share/fonts/noto-cjk/NotoSansCJK-Regular.ttc", 28)
            except:
                font_big = ImageFont.load_default()
                font_small = ImageFont.load_default()
            date_str = datetime.datetime.now().strftime('%Y年%m月%d日')
            draw.text((120, 320), "日经中文网", fill="white", font=font_big)
            draw.text((160, 420), date_str, fill="#cccccc", font=font_small)
            bio = BytesIO()
            img.save(bio, 'JPEG', quality=85)
            bio.seek(0)
            return bio.getvalue()
        except Exception as e:
            self.log.warn(f'封面生成失败: {e}')
            return None
