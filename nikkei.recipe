#!/usr/bin/env python
# -*- coding: utf-8 -*-
import re
import time
import os
from datetime import datetime, timezone
from opencc import OpenCC
from bs4 import BeautifulSoup
from selenium import webdriver
from selenium.webdriver.chrome.service import Service
from selenium.webdriver.chrome.options import Options

# 配置
OUTPUT_FILE = 'nikkei_feed.xml'
MAX_ARTICLE_NUM = 30
PAGE_SLEEP = 2
ARTICLE_SLEEP = 1
MAX_RETRY = 3
BASE_URL = 'https://cn.nikkei.com'

# 繁简转换兼容
try:
    cc = OpenCC('t2s')
except Exception as e:
    print(f"OpenCC load failed, skip convert: {e}")
    class FakeCC:
        def convert(self, x):
            return x
    cc = FakeCC()

# XML转义
def escape_xml(text):
    if not text:
        return ''
    s = str(text)
    s = s.replace('&', '&amp;')
    s = s.replace('<', '&lt;')
    s = s.replace('>', '&gt;')
    s = s.replace('"', '&quot;')
    s = s.replace("'", '&apos;')
    return s

def cdata_clean(text):
    if not text:
        return ""
    return str(text).replace("]]>", "]]&gt;")

# 初始化无头Chrome
def get_driver():
    chrome_options = Options()
    chrome_options.add_argument("--headless=new")
    chrome_options.add_argument("--no-sandbox")
    chrome_options.add_argument("--disable-dev-shm-usage")
    chrome_options.add_argument("--window-size=1280,720")
    chrome_options.add_argument("--disable-blink-features=AutomationControlled")
    chrome_options.add_experimental_option("excludeSwitches", ["enable-automation"])
    chrome_options.add_experimental_option("useAutomationExtension", False)
    driver_path = os.environ.get("CHROME_DRIVER", "/usr/lib/chromium-browser/chromedriver")
    service = Service(driver_path)
    driver = webdriver.Chrome(service=service, options=chrome_options)
    driver.execute_script("Object.defineProperty(navigator, 'webdriver', {get: () => undefined})")
    return driver

# 加载渲染页面
def get_rendered_html(url, driver, wait_sec=3):
    try:
        driver.get(url)
        time.sleep(wait_sec)
        html = driver.page_source
        return html
    except Exception as e:
        print(f"Load page fail {url}: {e}")
        return None

# 提取新闻链接
def extract_article_list(html, global_seen):
    soup = BeautifulSoup(html, 'html.parser')
    page_articles = []
    ban_words = ['登录', '注册', '导航', '首页', '菜单']
    all_links = soup.find_all('a', href=True)
    for a in all_links:
        href = a['href'].strip()
        title_raw = a.get_text(strip=True)
        if "/article/" not in href:
            continue
        if len(title_raw) < 6:
            continue
        if any(w in title_raw for w in ban_words):
            continue
        if href.startswith('/'):
            full_link = BASE_URL + href
        elif href.startswith("http") and BASE_URL in href:
            full_link = href
        else:
            continue
        if full_link in global_seen:
            continue
        global_seen.add(full_link)
        title_cn = cc.convert(title_raw)
        page_articles.append({"title": title_cn, "url": full_link})
        if len(page_articles) >= MAX_ARTICLE_NUM:
            break
    return page_articles

# 抓取文章正文
def get_article_content(url, driver):
    html = get_rendered_html(url, driver, wait_sec=2)
    if not html:
        return f"原文加载失败，访问链接查看：{url}"
    soup = BeautifulSoup(html, 'html.parser')
    for tag in soup(["script", "style", "iframe", "nav", "footer", "aside", "header"]):
        tag.decompose()
    content_blocks = soup.find_all('p')
    content_text = ""
    for p in content_blocks:
        para = p.get_text(strip=True)
        if len(para) > 10:
            para_cn = cc.convert(para)
            content_text += para_cn + "\n\n"
    if len(content_text) < 50:
        content_text = soup.get_text(strip=True)
    if len(content_text) > 6000:
        content_text = content_text[:5900] + f"...内容过长截断，原文：{url}"
    return content_text

# 主逻辑
def fetch_and_build_rss():
    print("===== Start Nikkei Crawler (JS Render Support) =====")
    driver = get_driver()
    crawl_pages = [
        BASE_URL,
        BASE_URL + "/china/",
        BASE_URL + "/economy/",
        BASE_URL + "/tech/",
        BASE_URL + "/opinion/"
    ]
    all_articles = []
    seen_urls = set()
    try:
        for page in crawl_pages:
            print(f"\nFetch page: {page}")
            html = get_rendered_html(page, driver, wait_sec=4)
            if not html:
                continue
            page_data = extract_article_list(html, seen_urls)
            all_articles.extend(page_data)
            print(f"Total articles now: {len(all_articles)}")
            time.sleep(PAGE_SLEEP)
            if len(all_articles) >= MAX_ARTICLE_NUM:
                break
        all_articles = all_articles[:MAX_ARTICLE_NUM]
        print(f"\nTotal fetched articles: {len(all_articles)}, start fetch content...")
        rss_items = []
        build_time = datetime.now(timezone.utc).strftime("%a, %d %b %Y %H:%M:%S GMT")
        for idx, art in enumerate(all_articles):
            print(f"[{idx+1}/{len(all_articles)}] {art['title']}")
            content = get_article_content(art['url'], driver)
            time.sleep(ARTICLE_SLEEP)
            item_xml = f"""
<item>
<title>{escape_xml(art['title'])}</title>
<link>{escape_xml(art['url'])}</link>
<description><![CDATA[{cdata_clean(content)}]]></description>
<pubDate>{build_time}</pubDate>
</item>
"""
            rss_items.append(item_xml)
        full_rss = f"""<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0">
<channel>
<title>日经中文网（简体自动抓取）</title>
<link>{BASE_URL}</link>
<description>JS动态页面渲染抓取，繁体转简体，适配Kindle推送</description>
<lastBuildDate>{build_time}</lastBuild>
{"".join(rss_items)}
</channel>
</rss>
"""
        with open(OUTPUT_FILE, 'w', encoding='utf-8') as f:
            f.write(full_rss)
        print(f"\n✅ RSS file generated: {OUTPUT_FILE}")
    finally:
        driver.quit()

if __name__ == '__main__':
    fetch_and_build_rss()
