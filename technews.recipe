#!/usr/bin/env python
# vim:fileencoding=utf-8
from __future__ import unicode_literals, division, absolute_import, print_function
import re
import datetime
from calibre.web.feeds.news import BasicNewsRecipe

class TechNewsRecipe(BasicNewsRecipe):
    title = '科技新报 (TechNews) - ' + datetime.datetime.now().strftime('%Y-%m-%d')
    language = 'zh-TW'
    oldest_article = 2
    max_articles_per_feed = 20
    auto_cleanup = True
    remove_javascript = True
    compress_news_images = True
    scale_news_images_to = 600

    # 核心抓取配置
    feeds = [
        ('科技新报', 'https://technews.tw/feed/'),
    ]

    # 内容清洗规则
    keep_only_tags = [
        dict(name='h1', attrs={'class': 'post-title'}),
        dict(name='div', attrs={'class': 'single-post-content'}),
    ]

    remove_tags = [
        dict(name='script'), dict(name='style'), dict(name='iframe'),
        dict(name='nav'), dict(name='header'), dict(name='footer'),
        dict(name='aside'),
        dict(name='div', attrs={'class': re.compile(r'ad|share|social|related|comment|sidebar|tags|meta', re.I)}),
        dict(name='div', attrs={'id': re.compile(r'disqus_thread', re.I)}),
    ]

    def preprocess_html(self, soup):
        # 修复图片懒加载问题 (TechNews 常用 data-src)
        for img in soup.find_all('img'):
            real_src = img.get('data-src') or img.get('data-lazy-src') or img.get('src', '')
            if real_src and not real_src.startswith('http'):
                if real_src.startswith('//'):
                    real_src = 'https:' + real_src
                elif real_src.startswith('/'):
                    real_src = 'https://technews.tw' + real_src
                img['src'] = real_src
        return soup

