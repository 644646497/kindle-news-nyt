#!/usr/bin/env python
# vim:fileencoding=utf-8
from __future__ import unicode_literals, division, absolute_import, print_function
import re
import datetime
import time
import os
import subprocess
from io import BytesIO
from PIL import Image, ImageDraw, ImageFont
from calibre.web.feeds.news import BasicNewsRecipe

try:
    from opencc import OpenCC
    cc = OpenCC('t2s')
    CAN_CONVERT = True
except ImportError:
    CAN_CONVERT = False

def ensure_chinese_font():
    font_paths = [
        "/usr/share/fonts/truetype/noto/NotoSansCJK-Regular.ttc",
        "/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc"
    ]
    for path in font_paths:
        if os.path.exists(path):
            return path
    print(">>> 未检测到中文字体，正在尝试安装...")
    try:
        subprocess.run(["sudo", "apt-get", "update"], check=True, capture_output=True)
        subprocess.run(["sudo", "apt-get", "install", "-y", "fonts-noto-cjk"], check=True, capture_output=True)
        subprocess.run(["fc-cache", "-f"], check=True, capture_output=True)
        for path in font_paths:
            if os.path.exists(path):
                return path
    except Exception as e:
        print(f">>> 安装字体失败: {e}")
    return None

FONT_PATH = ensure_chinese_font()

class TechNewsRecipe(BasicNewsRecipe):
    # 🔧 改成科技新报
    title = '科技新报 - ' + datetime.datetime.now().strftime('%Y-%m-%d %H:%M')
    language = 'zh-CN'
    oldest_article = 1
    max_articles_per_feed = 15
    auto_cleanup = True
    no_stylesheets = False
    remove_javascript = True
    compress_news_images = True
    scale_news_images_to = 600

    # 🔧 联合报的正文选择器（科技新报也适用）
    keep_only_tags = [
        dict(name='h1'),
        dict(name='div', attrs={'class': re.compile(r'entry-content|article-content')}),
        dict(name='article'),
    ]

    remove_tags = [
        dict(name='script'), dict(name='style'), dict(name='iframe'),
        dict(name='nav'), dict(name='header'), dict(name='footer'),
        dict(name='aside'),
        dict(name='div', attrs={'class': re.compile(r'ad|share|related|comment|sidebar|tags|meta', re.I)}),
    ]

    # 🔧 直接用 RSS（和联合报不一样，科技新报有 RSS）
    feeds = [
        ('科技新报', 'https://technews.tw/tn-rss/'),
    ]

    # 🔧 不需要 parse_index，RSS 会自动处理
    
    def preprocess_html(self, soup):
        """预处理：删除广告和赞助内容"""
        
        # 1. 删除"请喝咖啡"相关内容（科技新报特有）
        for tag in soup.find_all(string=re.compile(r'喝咖啡|贊助|咖啡|請我們喝|Support us|想請我們喝', re.I)):
            if tag.parent:
                parent = tag.find_parent(['div', 'p', 'section'])
                if parent:
                    parent.decompose()
        
        # 2. 删除赞助相关链接
        for tag in soup.find_all('a', href=re.compile(r'buycoffee|donate|sponsor', re.I)):
            tag.decompose()
        
        # 3. 删除"延伸阅读"后面的内容
        for tag in soup.find_all(string=re.compile(r'延伸閱讀|相關文章|推薦閱讀', re.I)):
            if tag.parent:
                current = tag.parent
                while current:
                    next_elem = current.find_next_sibling()
                    current.decompose()
                    current = next_elem
        
        # 4. 处理图片（和联合报一样）
        for img in soup.find_all('img'):
            real_src = img.get('data-src') or img.get('data-original') or img.get('src', '')
            if real_src:
                if real_src.startswith('//'):
                    real_src = 'https:' + real_src
                elif real_src.startswith('/'):
                    real_src = 'https://technews.tw' + real_src
                img['src'] = real_src
        
        # 5. 删除广告div
        for tag in soup.find_all('div', class_=re.compile(r'ad|share|social|donate|coffee', re.I)):
            tag.decompose()
        
        return soup

    def postprocess_html(self, soup, first_fetch):
        """后处理：繁体转简体（和联合报一样）"""
        if CAN_CONVERT:
            for element in soup.find_all(string=True):
                text = str(element)
                if len(text) > 3:
                    if element.parent and element.parent.name not in ['script', 'style']:
                        try:
                            converted = cc.convert(text)
                            if converted != text:
                                element.replace_with(converted)
                        except:
                            pass
        return soup

    # 🔧 封面：和联合报一模一样的代码
    def get_cover_url(self):
        width, height = 600, 800
        background_color = '#FFFFFF'
        text_color = '#000000'

        img = Image.new('RGB', (width, height), color=background_color)
        draw = ImageDraw.Draw(img)

        font_path = FONT_PATH
        font_large_size = 80
        font_small_size = 40

        try:
            if font_path:
                font_large = ImageFont.truetype(font_path, font_large_size)
                font_small = ImageFont.truetype(font_path, font_small_size)
            else:
                # 降级：用默认字体画英文
                font_large = ImageFont.load_default()
                font_small = ImageFont.load_default()
                draw.text((width//2, height*0.35), "TechNews", font=font_large, fill=text_color, anchor='mm')
                draw.text((width//2, height*0.55), datetime.datetime.now().strftime('%Y-%m-%d %H:%M'), font=font_small, fill=text_color, anchor='mm')
                buf = BytesIO()
                img.save(buf, format='PNG')
                buf.seek(0)
                return buf
        except:
            font_large = ImageFont.load_default()
            font_small = ImageFont.load_default()

        # 画中文标题
        draw.text((width//2, height*0.35), "科技新报", font=font_large, fill=text_color, anchor='mm')
        draw.text((width//2, height*0.55), datetime.datetime.now().strftime('%Y-%m-%d %H:%M'), font=font_small, fill=text_color, anchor='mm')

        buf = BytesIO()
        img.save(buf, format='PNG')
        buf.seek(0)
        return buf

if __name__ == "__main__":
    from calibre.web.feeds.recipes.utils import cli
    cli(TechNewsRecipe)
