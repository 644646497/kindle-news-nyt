#!/usr/bin/env python
# vim:fileencoding=utf-8
from __future__ import unicode_literals, division, absolute_import, print_function
import re
import datetime
import time
import os
import subprocess
from io import BytesIO
from PIL import Image, ImageDraw, ImageFont
from calibre.web.feeds.news import BasicNewsRecipe

try:
    from opencc import OpenCC
    cc = OpenCC('t2s')
    CAN_CONVERT = True
except ImportError:
    CAN_CONVERT = False

# --- 1. 环境初始化：自动安装中文字体 (解决方块问题) ---
def ensure_chinese_font():
    font_paths = [
        "/usr/share/fonts/truetype/noto/NotoSansCJK-Regular.ttc",
        "/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc"
    ]
    for path in font_paths:
        if os.path.exists(path):
            return path
    print(">>> 未检测到中文字体，正在尝试安装...")
    try:
        subprocess.run(["sudo", "apt-get", "update"], check=True, capture_output=True)
        subprocess.run(["sudo", "apt-get", "install", "-y", "fonts-noto-cjk"], check=True, capture_output=True)
        subprocess.run(["fc-cache", "-f"], check=True, capture_output=True)
        for path in font_paths:
            if os.path.exists(path):
                return path
    except Exception as e:
        print(f">>> 安装字体失败: {e}")
    return None


class TechNewsRecipe(BasicNewsRecipe):
    title = '科技新报 - ' + datetime.datetime.now().strftime('%Y-%m-%d %H:%M')
    language = 'zh-CN'
    oldest_article = 2
    max_articles_per_feed = 20
    auto_cleanup = True
    no_stylesheets = False
    remove_javascript = False  # 【关键修改1】允许执行JS，防止首页是动态渲染的
    compress_news_images = True
    scale_news_images_to = 600

    # 【关键修改2】增加备用 RSS 源，如果首页抓取失败，Calibre 会尝试使用 RSS
    feeds = [
        ('科技新报 RSS', 'https://technews.tw/feed/'),
    ]

    keep_only_tags = [
        dict(name='h1'),
        dict(name='div', attrs={'class': re.compile(r'article-content|entry-content|post-body|single-post-content', re.I)}),
        dict(name='article'),
    ]

    remove_tags = [
        dict(name='script'), dict(name='style'), dict(name='iframe'),
        dict(name='nav'), dict(name='header'), dict(name='footer'),
        dict(name='aside'),
        dict(name='div', attrs={'class': re.compile(r'ad|share|related|comment|sidebar|tags|meta|social|paywall', re.I)}),
    ]

    def parse_index(self):
        feeds = []
        sections = [('科技新报 - 首页', 'https://technews.tw/')]

        for section_name, section_url in sections:
            try:
                soup = self.index_to_soup(section_url)
                articles = []
                seen_urls = set()

                # 【关键修改3】放宽链接匹配规则，同时匹配多种可能的链接格式
                link_pattern = re.compile(r'^/\d{4}/\d{2}/\d{2}/|/news/|/technews/')

                for link in soup.find_all('a', href=link_pattern):
                    title = link.get_text(strip=True)
                    # 过滤掉太短的标题（通常是导航按钮）
                    if title and len(title) > 5:
                        url = link.get('href')
                        if url.startswith('/'):
                            url = 'https://technews.tw' + url
                        
                        # 去除URL末尾的斜杠以便去重
                        clean_url = url.rstrip('/')
                        if clean_url in seen_urls:
                            continue
                        seen_urls.add(clean_url)
                        articles.append({'title': title, 'url': url, 'date': '', 'description': ''})
                    
                    if len(articles) >= self.max_articles_per_feed:
                        break

                # 【关键修改4】加入调试日志，如果没抓到文章，打印当前页面的HTML片段以便排查
                if not articles:
                    self.log.error(f"!!! 警告: 在 {section_name} 未找到任何文章链接。")
                    self.log.error(f"当前页面部分HTML内容: {str(soup)[:1000]}")
                else:
                    self.log.info(f"成功在 {section_name} 找到 {len(articles)} 篇文章。")

                if articles:
                    feeds.append((section_name, articles))
            except Exception as e:
                self.log.error(f"抓取 {section_name} 失败: {e}")

        return feeds

    def preprocess_html(self, soup):
        for img in soup.find_all('img'):
            real_src = img.get('data-src') or img.get('data-original') or img.get('src', '')
            if real_src:
                if real_src.startswith('//'):
                    real_src = 'https:' + real_src
                elif real_src.startswith('/'):
                    real_src = 'https://technews.tw' + real_src
                img['src'] = real_src
        for tag in soup.find_all('div', class_=re.compile(r'ad|share|social|paywall', re.I)):
            tag.decompose()
        return soup

    def postprocess_html(self, soup, first_fetch):
        if CAN_CONVERT:
            for element in soup.find_all(string=True):
                text = str(element)
                if len(text) > 3:
                    if element.parent and element.parent.name not in ['script', 'style']:
                        try:
                            converted = cc.convert(text)
                            if converted != text:
                                element.replace_with(converted)
                        except:
                            pass
        return soup

    # --- 2. 动态生成封面 ---
    def get_cover_url(self):
        width, height = 600, 800
        background_color = '#FFFFFF'
        text_color = '#000000'

        img = Image.new('RGB', (width, height), color=background_color)
        draw = ImageDraw.Draw(img)

        font_path = ensure_chinese_font()
        font_large_size = 80
        font_small_size = 40

        try:
            if font_path:
                font_large = ImageFont.truetype(font_path, font_large_size)
                font_small = ImageFont.truetype(font_path, font_small_size)
            else:
                font_large = ImageFont.load_default()
                font_small = ImageFont.load_default()
        except:
            font_large = ImageFont.load_default()
            font_small = ImageFont.load_default()

        draw.text((width//2, height * 0.40), "科技新报 TechNews", font=font_large, fill=text_color, anchor='mm')
        draw.text((width//2, height * 0.55), datetime.datetime.now().strftime('%Y-%m-%d %H:%M'), font=font_small, fill=text_color, anchor='mm')

        buf = BytesIO()
        img.save(buf, format='JPEG')
        buf.seek(0)
        return buf
