#!/usr/bin/env python
# vim:fileencoding=utf-8
from __future__ import unicode_literals, division, absolute_import, print_function
import re
import datetime
import time
import os
import subprocess
from io import BytesIO
from PIL import Image, ImageDraw, ImageFont
from calibre.web.feeds.news import BasicNewsRecipe

try:
    from opencc import OpenCC
    cc = OpenCC('t2s')
    CAN_CONVERT = True
except ImportError:
    CAN_CONVERT = False

# --- 1. 环境初始化：自动安装中文字体 (解决方块问题) ---
def ensure_chinese_font():
    font_paths = [
        "/usr/share/fonts/truetype/noto/NotoSansCJK-Regular.ttc",
        "/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc"
    ]
    for path in font_paths:
        if os.path.exists(path):
            return path
    print(">>> 未检测到中文字体，正在尝试安装...")
    try:
        subprocess.run(["sudo", "apt-get", "update"], check=True, capture_output=True)
        subprocess.run(["sudo", "apt-get", "install", "-y", "fonts-noto-cjk"], check=True, capture_output=True)
        subprocess.run(["fc-cache", "-f"], check=True, capture_output=True)
        for path in font_paths:
            if os.path.exists(path):
                return path
    except Exception as e:
        print(f">>> 安装字体失败: {e}")
    return None


class TechNewsRecipe(BasicNewsRecipe):
    title = '科技新报 - ' + datetime.datetime.now().strftime('%Y-%m-%d %H:%M')
    language = 'zh-CN'
    oldest_article = 2
    max_articles_per_feed = 20
    auto_cleanup = True
    no_stylesheets = False
    remove_javascript = True
    compress_news_images = True
    scale_news_images_to = 600

    # 强制使用 RSS 源，或者抓取具体的频道页，避开无法解析的 JS 首页
    feeds = [
        ('最新文章', 'https://technews.tw/feed/'),
        ('人工智能', 'https://technews.tw/category/ai/feed/'),
        ('智能手机', 'https://technews.tw/category/smartphone/feed/'),
    ]

    keep_only_tags = [
        dict(name='h1'),
        dict(name='div', attrs={'class': re.compile(r'article-content|entry-content|post-body|single-post-content', re.I)}),
        dict(name='article'),
    ]

    remove_tags = [
        dict(name='script'), dict(name='style'), dict(name='iframe'),
        dict(name='nav'), dict(name='header'), dict(name='footer'),
        dict(name='aside'),
        dict(name='div', attrs={'class': re.compile(r'ad|share|related|comment|sidebar|tags|meta|social|paywall', re.I)}),
    ]

    # --- 封面生成 (保持不变) ---
    def get_cover_url(self):
        width, height = 600, 800
        background_color = '#FFFFFF'
        text_color = '#000000'

        img = Image.new('RGB', (width, height), color=background_color)
        draw = ImageDraw.Draw(img)

        font_path = ensure_chinese_font()
        font_large_size = 80
        font_small_size = 40

        try:
            if font_path:
                font_large = ImageFont.truetype(font_path, font_large_size)
                font_small = ImageFont.truetype(font_path, font_small_size)
            else:
                font_large = ImageFont.load_default()
                font_small = ImageFont.load_default()
        except:
            font_large = ImageFont.load_default()
            font_small = ImageFont.load_default()

        draw.text((width//2, height * 0.40), "科技新报 TechNews", font=font_large, fill=text_color, anchor='mm')
        draw.text((width//2, height * 0.55), datetime.datetime.now().strftime('%Y-%m-%d %H:%M'), font=font_small, fill=text_color, anchor='mm')

        buf = BytesIO()
        img.save(buf, format='JPEG')
        buf.seek(0)
        return buf

