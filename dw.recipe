from calibre.web.feeds.news import BasicNewsRecipe

try:
    from opencc import OpenCC
    cc = OpenCC('t2s')
    CAN_CONVERT = True
except ImportError:
    CAN_CONVERT = False

def ensure_chinese_font():
    font_paths = [
        "/usr/share/fonts/truetype/noto/NotoSansCJK-Regular.ttc",
        "/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc"
    ]
    for path in font_paths:
        if os.path.exists(path):
            return path
    print(">>> 未检测到中文字体，正在尝试安装...")
    try:
        subprocess.run(["sudo", "apt-get", "update"], check=True, capture_output=True)
        subprocess.run(["sudo", "apt-get", "install", "-y", "fonts-noto-cjk"], check=True, capture_output=True)
        subprocess.run(["fc-cache", "-f"], check=True, capture_output=True)
        for path in font_paths:
            if os.path.exists(path):
                return path
    except Exception as e:
        print(f">>> 安装字体失败: {e}")
    return None

FONT_PATH = ensure_chinese_font()

class DWRecipe(BasicNewsRecipe):
    title = '德国之声中文网 - ' + datetime.datetime.now().strftime('%Y-%m-%d')
    language = 'zh-CN'
    oldest_article = 1
    max_articles_per_feed = 25
    auto_cleanup = True
    remove_javascript = True
    compress_news_images = True
    scale_news_images_to = 600
    
    # 使用 feeds
    feeds = [
        ('德国之声中文网', 'https://rss.dw.com/rdf/rss-zh')
    ]
    
    # 不使用 keep_only_tags，用 remove_tags 移除干扰
    remove_tags = [
        dict(name='script'), dict(name='style'), dict(name='iframe'),
        dict(name='nav'), dict(name='header'), dict(name='footer'),
        dict(name='aside'),
        dict(name='div', attrs={'class': re.compile(r'ad|advertisement|sponsor|promo|banner|share|social|related|recommend', re.I)}),
        dict(name='div', attrs={'id': re.compile(r'ad|advertisement|sponsor|promo|banner|share|social|related|recommend', re.I)}),
        dict(name='div', attrs={'class': re.compile(r'comment|discussion|response|tag|meta', re.I)}),
    ]

    extra_css = '''
        body { 
            font-family: "Noto Sans CJK SC", "PingFang SC", "Microsoft YaHei", sans-serif;
            line-height: 1.8;
            font-size: 16px;
            color: #333;
            max-width: 700px;
            margin: 0 auto;
            padding: 20px;
        }
        h1 { 
            font-size: 24px; 
            font-weight: bold; 
            margin: 20px 0 10px 0;
            color: #1a1a2e;
            line-height: 1.4;
        }
        h2 { 
            font-size: 20px; 
            font-weight: bold; 
            margin: 15px 0 8px 0;
            color: #2d2d44;
        }
        p { 
            margin: 10px 0; 
            text-indent: 2em;
            text-align: justify;
        }
        img { 
            max-width: 100%; 
            height: auto; 
            display: block; 
            margin: 10px auto; 
        }
        blockquote { 
            border-left: 4px solid #e94560; 
            padding-left: 20px; 
            margin-left: 20px; 
            color: #555; 
        }
    '''

    def preprocess_html(self, soup):
        # 修复图片
        for img in soup.find_all('img'):
            src = img.get('data-src') or img.get('src', '')
            if src:
                if src.startswith('//'):
                    src = 'https:' + src
                elif src.startswith('/') and not src.startswith('//'):
                    src = 'https://www.dw.com' + src
                img['src'] = src
        
        # 尝试找到文章主体 - 德国之声的文章通常在 div 中
        # 如果找到了 article 或 content 容器，保留它
        article_body = None
        
        # 尝试常见的选择器
        selectors = [
            ('div', {'class': re.compile(r'article-content|story-content|entry-content|post-content', re.I)}),
            ('div', {'class': re.compile(r'content|article-body|story-body', re.I)}),
            ('div', {'itemprop': 'articleBody'}),
            ('article', {}),
        ]
        
        for tag_name, attrs in selectors:
            if attrs:
                article_body = soup.find(tag_name, attrs=attrs)
            else:
                article_body = soup.find(tag_name)
            if article_body:
                break
        
        if article_body:
            # 只保留文章主体
            soup = article_body
        
        return soup

    def postprocess_html(self, soup, first_fetch):
        # 恢复标题
        if not soup.find('h1'):
            title_tag = soup.find('title')
            if title_tag:
                title = title_tag.get_text(strip=True)
                title = re.sub(r'\s*[|•-]\s*德国之声.*$', '', title).strip()
                title = re.sub(r'^DW\s*[|•-]\s*', '', title).strip()
                if title and len(title) > 5:
                    new_h1 = soup.new_tag('h1')
         