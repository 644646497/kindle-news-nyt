#!/usr/bin/env python
# vim:fileencoding=utf-8
from __future__ import unicode_literals, division, absolute_import, print_function
import re
import datetime
import os
import subprocess
import urllib.request
import gzip
from io import BytesIO
from PIL import Image, ImageDraw, ImageFont
from calibre.web.feeds.news import BasicNewsRecipe

try:
    from opencc import OpenCC
    cc = OpenCC('t2s')
    CAN_CONVERT = True
except ImportError:
    CAN_CONVERT = False

def ensure_chinese_font():
    font_paths = [
        "/usr/share/fonts/truetype/noto/NotoSansCJK-Regular.ttc",
        "/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc"
    ]
    for path in font_paths:
        if os.path.exists(path):
            return path
    print(">>> 未检测到中文字体，正在尝试安装...")
    try:
        subprocess.run(["sudo", "apt-get", "update"], check=True, capture_output=True)
        subprocess.run(["sudo", "apt-get", "install", "-y", "fonts-noto-cjk"], check=True, capture_output=True)
        subprocess.run(["fc-cache", "-f"], check=True, capture_output=True)
        for path in font_paths:
            if os.path.exists(path):
                return path
    except Exception as e:
        print(f">>> 安装字体失败: {e}")
    return None

FONT_PATH = ensure_chinese_font()

class DWRecipe(BasicNewsRecipe):
    title = '德国之声中文网 - ' + datetime.datetime.now().strftime('%Y-%m-%d')
    language = 'zh-CN'
    oldest_article = 1
    max_articles_per_feed = 25
    auto_cleanup = True
    remove_javascript = True
    compress_news_images = True
    scale_news_images_to = 600
    
    keep_only_tags = [
        dict(name='h1'),
        dict(name='article', attrs={'class': re.compile(r'article-content')}),
        dict(name='div', attrs={'class': re.compile(r'article-body|article-content|story-body|entry-content|post-content|main-content')}),
        dict(name='div', attrs={'class': re.compile(r'content|main', re.I)}),
        dict(name='article'),
        dict(name='main'),
    ]

    remove_tags = [
        dict(name='script'), dict(name='style'), dict(name='iframe'),
        dict(name='nav'), dict(name='header'), dict(name='footer'),
        dict(name='aside'),
        dict(name='div', attrs={'class': re.compile(r'ad|advertisement|sponsor|promo|banner|share|social', re.I)}),
        dict(name='div', attrs={'id': re.compile(r'ad|advertisement|sponsor|promo|banner|share|social', re.I)}),
    ]

    extra_css = '''
        body { 
            font-family: "Noto Sans CJK SC", "PingFang SC", "Microsoft YaHei", sans-serif;
            line-height: 1.8;
            font-size: 16px;
            color: #333;
            max-width: 700px;
            margin: 0 auto;
            padding: 20px;
        }
        h1 { font-size: 24px; font-weight: bold; margin: 20px 0 10px 0; color: #1a1a2e; }
        p { margin: 10px 0; text-indent: 2em; text-align: justify; }
        img { max-width: 100%; height: auto; display: block; margin: 10px auto; }
        blockquote { border-left: 4px solid #e94560; padding-left: 20px; margin-left: 20px; color: #555; }
    '''

    def parse_index(self):
        feeds = []
        # 德国之声的RSS - 可能被gzip压缩
        rss_url = 'https://rss.dw.com/rdf/rss-zh'
        
        try:
            self.log.info(f'正在抓取: {rss_url}')
            headers = {
                'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36',
                'Accept-Encoding': 'gzip, deflate'
            }
            req = urllib.request.Request(rss_url, headers=headers)
            
            with urllib.request.urlopen(req, timeout=30) as response:
                # 检查是否被gzip压缩
                content_encoding = response.headers.get('Content-Encoding', '')
                data = response.read()
                
                if 'gzip' in content_encoding:
                    # 解压gzip
                    self.log.info('检测到gzip压缩，正在解压...')
                    import gzip
                    rss_content = gzip.decompress(data).decode('utf-8')
                else:
                    rss_content = data.decode('utf-8')
            
            self.log.info(f'RSS内容长度: {len(rss_content)} 字符')
            
            # 使用正则提取文章（避免XML解析问题）
            articles = []
            seen_urls = set()
            
            # 提取 title 和 link
            # 注意德国之声的RSS是RDF格式
            title_pattern = re.compile(r'<title[^>]*>(.*?)</title>', re.DOTALL)
            link_pattern = re.compile(r'<link[^>]*>(.*?)</link>', re.DOTALL)
            
            # 按 item 分割
            item_pattern = re.compile(r'<item[^>]*>(.*?)</item>', re.DOTALL)
            items = item_pattern.findall(rss_content)
            
            self.log.info(f'找到 {len(items)} 个items')
            
            for item in items:
                title_match = title_pattern.search(item)
                link_match = link_pattern.search(item)
                
                if title_match and link_match:
                    title = title_match.group(1).strip()
                    url = link_match.group(1).strip()
                    
                    # 清理 CDATA
                    title = re.sub(r'<!\[CDATA\[(.*?)\]\]>', r'\1', title)
                    
                    # 过滤无效标题
                    if not title or len(title) < 5:
                        continue
                    if not url or not url.startswith('http'):
                        continue
                    if url in seen_urls:
                        continue
                    
                    seen_urls.add(url)
                    articles.append({
                        'title': title,
                        'url': url,
                        'date': '',
                        'description': ''
                    })
                    
                    if len(articles) >= self.max_articles_per_feed:
                        break
            
            if articles:
                feeds.append(('德国之声中文网', articles))
                self.log.info(f'✅ 成功抓取 {len(articles)} 篇文章')
            else:
                self.log.warning('⚠️ 未抓到任何文章')
                # 尝试备用RSS地址
                self.log.info('尝试备用RSS地址...')
                backup_urls = [
                    'https://rss.dw.com/zh/chinese/rss.xml',
                    'https://www.dw.com/zh/德国之声新闻/s-9077?maca=zh-rss-zh-9077-rdf'
                ]
                for backup_url in backup_urls:
                    try:
                        self.log.info(f'尝试: {backup_url}')
                        req = urllib.request.Request(backup_url, headers=headers)
                        with urllib.request.urlopen(req, timeout=30) as response:
                            data = response.read()
                            content_encoding = response.headers.get('Content-Encoding', '')
                            if 'gzip' in content_encoding:
                                rss_content = gzip.decompress(data).decode('utf-8')
                            else:
                                rss_content = data.decode('utf-8')
                        
                        items = item_pattern.findall(rss_content)
                        backup_articles = []
                        for item in items:
                            title_match = title_pattern.search(item)
                            link_match = link_pattern.search(item)
                            if title_match and link_match:
                                title = re.sub(r'<!\[CDATA\[(.*?)\]\]>', r'\1', title_match.group(1).strip())
                                url = link_match.group(1).strip()
                                if title and url and len(title) > 5 and url.startswith('http'):
                                    if url not in seen_urls:
                                        seen_urls.add(url)
                                        backup_articles.append({
                                            'title': title,
                                            'url': url,
                                            'date': '',
                                            'description': ''
                                        })
                        
                        if backup_articles:
                            feeds.append(('德国之声中文网', backup_articles))
                            self.log.info(f'✅ 从备用地址成功抓取 {len(backup_articles)} 篇文章')
                            break
                    except Exception as e:
                        self.log.error(f'备用地址失败: {e}')
                        continue
                
        except Exception as e:
            self.log.error(f'❌ 解析RSS失败: {str(e)}')
            import traceback
            self.log.error(traceback.format_exc())
        
        return feeds

    def preprocess_html(self, soup):
        for img in soup.find_all('img'):
            src = img.get('data-src') or img.get('src', '')
            if src:
                if src.startswith('//'):
                    src = 'https:' + src
                elif src.startswith('/') and not src.startswith('//'):
                    src = 'https://www.dw.com' + src
                img['src'] = src
        return soup

    def postprocess_html(self, soup, first_fetch):
        # 恢复标题
        if not soup.find('h1'):
            title_tag = soup.find('title')
            if title_tag:
                title = title_tag.get_text(strip=True)
                title = re.sub(r'\s*[|•-]\s*德国之声.*$', '', title).strip()
                title = re.sub(r'^DW\s*[|•-]\s*', '', title).strip()
                if title and len(title) > 5:
                    new_h1 = soup.new_tag('h1')
                    new_h1.string = title
                    first_elem = soup.find(['p', 'div'])
                    if first_elem:
                        first_elem.insert_before(new_h1)
                    else:
                        body = soup.find('body')
                        if body:
                            body.insert(0, new_h1)
        
        # 简繁转换
        if CAN_CONVERT:
            for elem in soup.find_all(string=True):
                text = str(elem)
                if len(text) > 3:
                    parent = elem.parent
                    if parent and parent.name not in ['script', 'style']:
                        try:
                            converted = cc.convert(text)
                            if converted != text:
                                elem.replace_with(converted)
                        except:
                            pass
        return soup

    def get_cover_url(self):
        try:
            width, height = 600, 800
            img = Image.new('RGB', (width, height), color='#1a1a2e')
            draw = ImageDraw.Draw(img)
            
            font_path = FONT_PATH
            try:
                if font_path and os.path.exists(font_path):
                    font_large = ImageFont.truetype(font_path, 72)
                    font_medium = ImageFont.truetype(font_path, 36)
                    font_small = ImageFont.truetype(font_path, 28)
                else:
                    font_large = font_medium = font_small = ImageFont.load_default()
            except:
                font_large = font_medium = font_small = ImageFont.load_default()
            
            draw.rectangle([(50, 200), (550, 205)], fill='#e94560')
            
            title = '德国之声'
            subtitle = '中文网'
            date_str = datetime.datetime.now().strftime('%Y年%m月%d日')
            
            bbox = draw.textbbox((0, 0), title, font=font_large)
            tw = bbox[2] - bbox[0]
            draw.text(((width - tw) // 2, 250), title, fill='#ffffff', font=font_large)
            
            bbox = draw.textbbox((0, 0), subtitle, font=font_medium)
            sw = bbox[2] - bbox[0]
            draw.text(((width - sw) // 2, 340), subtitle, fill='#e94560', font=font_medium)
            
            bbox = draw.textbbox((0, 0), date_str, font=font_small)
            dw = bbox[2] - bbox[0]
            draw.text(((width - dw) // 2, 450), date_str, fill='#ffffff', font=font_small)
            
            cover_bytes = BytesIO()
            img.save(cover_bytes, 'JPEG', quality=85)
            cover_bytes.seek(0)
            return cover_bytes.getvalue()
            
        except Exception as e:
            self.log.error(f'封面生成失败: {e}')
            return None