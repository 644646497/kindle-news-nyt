#!/usr/bin/env python
# vim:fileencoding=utf-8
from __future__ import unicode_literals, division, absolute_import, print_function
import re
import datetime
import os
import subprocess
from io import BytesIO
from PIL import Image, ImageDraw, ImageFont
from calibre.web.feeds.news import BasicNewsRecipe

try:
    from opencc import OpenCC
    cc = OpenCC('t2s')
    CAN_CONVERT = True
except ImportError:
    CAN_CONVERT = False

def ensure_chinese_font():
    font_paths = [
        "/usr/share/fonts/truetype/noto/NotoSansCJK-Regular.ttc",
        "/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc"
    ]
    for path in font_paths:
        if os.path.exists(path):
            return path
    print(">>> 未检测到中文字体，正在尝试安装...")
    try:
        subprocess.run(["sudo", "apt-get", "update"], check=True, capture_output=True)
        subprocess.run(["sudo", "apt-get", "install", "-y", "fonts-noto-cjk"], check=True, capture_output=True)
        subprocess.run(["fc-cache", "-f"], check=True, capture_output=True)
        for path in font_paths:
            if os.path.exists(path):
                return path
    except Exception as e:
        print(f">>> 安装字体失败: {e}")
    return None

FONT_PATH = ensure_chinese_font()

class DWRecipe(BasicNewsRecipe):
    title = '德国之声中文网 - ' + datetime.datetime.now().strftime('%Y-%m-%d')
    language = 'zh-CN'
    oldest_article = 1
    max_articles_per_feed = 25
    auto_cleanup = True
    remove_javascript = True
    compress_news_images = True
    scale_news_images_to = 600
    
    # 使用 Calibre 的自动文章提取
    extract_article = True
    
    # 使用 feeds
    feeds = [
        ('德国之声中文网', 'https://rss.dw.com/rdf/rss-zh')
    ]
    
    # 只保留核心内容
    keep_only_tags = [
        dict(name='div', attrs={'class': re.compile(r'content|article|story|post|entry|body|text', re.I)}),
        dict(name='div', attrs={'itemprop': 'articleBody'}),
        dict(name='article'),
        dict(name='main'),
        dict(name='section', attrs={'class': re.compile(r'content|article|story', re.I)}),
    ]

    remove_tags = [
        dict(name='script'), dict(name='style'), dict(name='iframe'),
        dict(name='nav'), dict(name='header'), dict(name='footer'),
        dict(name='aside'),
        dict(name='div', attrs={'class': re.compile(r'ad|advertisement|sponsor|promo|banner|share|social|related|recommend|sidebar|breadcrumb', re.I)}),
        dict(name='div', attrs={'id': re.compile(r'ad|advertisement|sponsor|promo|banner|share|social|related|recommend|sidebar|breadcrumb', re.I)}),
        dict(name='div', attrs={'class': re.compile(r'comment|discussion|response|tag|meta|copyright', re.I)}),
    ]

    extra_css = '''
        body { 
            font-family: "Noto Sans CJK SC", "PingFang SC", "Microsoft YaHei", sans-serif;
            line-height: 1.8;
            font-size: 16px;
            color: #333;
            max-width: 700px;
            margin: 0 auto;
            padding: 20px;
        }
        h1 { 
            font-size: 24px; 
            font-weight: bold; 
            margin: 20px 0 10px 0;
            color: #1a1a2e;
            line-height: 1.4;
        }
        h2 { 
            font-size: 20px; 
            font-weight: bold; 
            margin: 15px 0 8px 0;
            color: #2d2d44;
        }
        p { 
            margin: 10px 0; 
            text-indent: 2em;
            text-align: justify;
        }
        img { 
            max-width: 100%; 
            height: auto; 
            display: block; 
            margin: 10px auto; 
        }
        blockquote { 
            border-left: 4px solid #e94560; 
            padding-left: 20px; 
            margin-left: 20px; 
            color: #555; 
        }
    '''

    def preprocess_html(self, soup):
        # 修复图片
        for img in soup.find_all('img'):
            src = img.get('data-src') or img.get('src', '')
            if src:
                if src.startswith('//'):
                    src = 'https:' + src
                elif src.startswith('/') and not src.startswith('//'):
                    src = 'https://www.dw.com' + src
                img['src'] = src
        
        # 德国之声特定处理：尝试找到文章内容的容器
        # 常见的是 class="text" 或 id="text"
        text_container = soup.find('div', class_='text') or soup.find('div', id='text')
        if text_container:
            # 如果找到了 text 容器，只保留它
            soup = text_container
        
        # 另一种常见结构
        article_container = soup.find('div', class_='article-content') or soup.find('div', id='article-content')
        if article_container:
            soup = article_container
        
        return soup

    def postprocess_html(self, soup, first_fetch):
        # 恢复标题
        if not soup.find('h1'):
            title_tag = soup.find('title')
            if title_tag:
                title = title_tag.get_text(strip=True)
                title = re.sub(r'\s*[|•-]\s*德国之声.*$', '', title).strip()
                title = re.sub(r'^DW\s*[|•-]\s*', '', title).strip()
        