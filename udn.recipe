#!/usr/bin/env python
# vim:fileencoding=utf-8
from __future__ import unicode_literals, division, absolute_import, print_function
import re
import datetime
from calibre.web.feeds.news import BasicNewsRecipe

try:
    from opencc import OpenCC
    cc = OpenCC('t2s')
    CAN_CONVERT = True
    print("✅ opencc 加载成功")
except ImportError:
    print("⚠️ 未找到 opencc 库，将跳过繁简转换")
    CAN_CONVERT = False

class UdnNewsRecipe(BasicNewsRecipe):
    title = '联合新闻网 - ' + datetime.datetime.now().strftime('%Y-%m-%d')
    language = 'zh-CN'
    __author__ = 'calibre user'
    
    oldest_article = 1
    max_articles_per_feed = 20
    auto_cleanup = True
    no_stylesheets = False
    remove_javascript = True
    
    compress_news_images = True
    compress_news_images_auto_size = 10
    scale_news_images = True
    scale_news_images_to = 600
    
    # 🔧 关键：只保留正文容器和它内部的图片
    keep_only_tags = [
        dict(name='h1'),
        dict(name='div', attrs={'class': re.compile(r'article-content|article_body|story-article|entry-content')}),
        dict(name='article'),
    ]
    
    # 🔧 移除所有噪音区域
    remove_tags = [
        dict(name='script'), dict(name='style'), dict(name='iframe'),
        dict(name='nav'), dict(name='header'), dict(name='footer'),
        dict(name='aside'),
        dict(name='div', attrs={'class': re.compile(r'ad|share|related|comment|sidebar|tags|meta|hot|popular|recommend', re.I)}),
        dict(name='div', attrs={'id': re.compile(r'ad|share|related|sidebar', re.I)}),
    ]
    
    def parse_index(self):
        feeds = []
        sections = [
            ('即时新闻', 'https://udn.com/news/breaknews/1/1'),
        ]
        
        for section_name, section_url in sections:
            self.log.info('正在抓取: ' + section_name)
            try:
                soup = self.index_to_soup(section_url)
                articles = []
                
                for link in soup.find_all('a', href=re.compile(r'/news/story/')):
                    title = link.get_text(strip=True)
                    if title and len(title) > 5:
                        url = link.get('href')
                        if url.startswith('/'):
                            url = 'https://udn.com' + url
                        articles.append({
                            'title': title,
                            'url': url,
                            'date': '',
                            'description': ''
                        })
                    if len(articles) >= self.max_articles_per_feed:
                        break
                
                if articles:
                    feeds.append((section_name, articles))
                    self.log.info('找到 ' + str(len(articles)) + ' 篇文章')
            except Exception as e:
                self.log.error('抓取失败: ' + str(e))
        
        return feeds
    
    def preprocess_html(self, soup):
        """预处理：清理所有噪音区域"""
        
        # 1. 先移除广告和分享按钮
        for tag in soup.find_all('div', class_=re.compile(r'ad|share|social', re.I)):
            tag.decompose()
        
        # 2. 🔧 移除“热门新闻”、“推荐阅读”等区域
        for tag in soup.find_all('div', class_=re.compile(r'hot|popular|recommend|related|latest', re.I)):
            tag.decompose()
        
        # 3. 🔧 移除侧边栏（通常有 sidebar 或 aside 标识）
        for tag in soup.find_all(['aside', 'div'], class_=re.compile(r'sidebar', re.I)):
            tag.decompose()
        
        # 4. 🔧 处理懒加载图片：将 data-src 转为 src
        for img in soup.find_all('img'):
            # 获取真实图片地址
            real_src = img.get('data-src') or img.get('data-original') or img.get('src', '')
            
            if real_src:
                # 补全相对路径
                if real_src.startswith('//'):
                    real_src = 'https:' + real_src
                elif real_src.startswith('/'):
                    real_src = 'https://udn.com' + real_src
                
                img['src'] = real_src
            
            # 删除无关属性
            for attr in ['data-src', 'data-original', 'class', 'id', 'width', 'height']:
                if attr in img.attrs:
                    del img.attrs[attr]
        
        return soup
    
    def postprocess_html(self, soup, first_fetch):
        """后处理：繁体转简体"""
        if not CAN_CONVERT:
            return soup
        
        # 🔧 只处理正文区域，提高速度和准确性
        content = soup.find('div', attrs={'class': re.compile(r'article-content|article_body|story-article')})
        if not content:
            content = soup.body
        
        if content:
            for element in content.find_all(string=True):
                original = str(element)
                if len(original) < 5:
                    continue
                if element.parent and element.parent.name in ['script', 'style']:
                    continue
                
                try:
                    converted = cc.convert(original)
                    if converted != original:
                        element.replace_with(converted        """后处理：繁体转简体"""
        if not CAN_CONVERT:
            print("⚠️ opencc 未安装，跳过繁转简")
            return soup
        
        print("✅ 开始繁转简...")
        count = 0
        
        for element in soup.find_all(string=True):
            original = str(element)
            if len(original) < 5:
                continue
            if element.parent and element.parent.name in ['script', 'style']:
                continue
            
            try:
                converted = cc.convert(original)
                if converted != original:
                    element.replace_with(converted)
                    count += 1
            except Exception as e:
                print(f"转换错误: {e}")
        
        print(f"✅ 转换了 {count} 个文本节点")
        return soup

if __name__ == "__main__":
    from calibre.web.feeds.recipes.utils import cli
    cli(UdnNewsRecipe)
