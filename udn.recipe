import re
import datetime
from calibre.web.feeds.news import BasicNewsRecipe

class UdnNewsRecipe(BasicNewsRecipe):
    title = '联合新闻网 - ' + datetime.datetime.now().strftime('%Y-%m-%d')
    language = 'zh-CN'
    oldest_article = 1
    max_articles_per_feed = 15
    auto_cleanup = True
    
    def parse_index(self):
        feeds = []
        url = 'https://udn.com/news/breaknews/1/1'
        soup = self.index_to_soup(url)
        articles = []
        
        for link in soup.find_all('a', href=re.compile(r'/news/story/')):
            title = link.get_text(strip=True)
            if title and len(title) > 5:
                article_url = link.get('href')
                if article_url.startswith('/'):
                    article_url = 'https://udn.com' + article_url
                articles.append({
                    'title': title,
                    'url': article_url,
                    'date': '',
                    'description': ''
                })
            if len(articles) >= self.max_articles_per_feed:
                break
        
        if articles:
            feeds.append(('即时新闻', articles))
        
        return feeds                    if converted != original:
                        element.replace_with(converted)
                        count += 1
                except Exception:
                    pass
        
        print(f"✅ 转换了 {count} 个文本节点")
        return soup

if __name__ == "__main__":
    from calibre.web.feeds.recipes.utils import cli
    cli(UdnNewsRecipe)
