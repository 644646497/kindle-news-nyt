import os
import time
import re
import datetime
from calibre.utils.localization import strftime
from calibre.web.feeds.recipes.chinese import simplify_chinese

os.environ['TZ'] = 'Asia/Shanghai'
time.tzset()

class AdvancedUserRecipeTechNews(BasicNewsRecipe):
    title = datetime.datetime.now().strftime('科技新报 - %Y-%m-%d %H-%M')
    language = 'zh_CN'
    oldest_article = 1
    max_articles_per_feed = 15

    no_summaries = False
    use_embedded_content = False
    auto_cleanup = True

    remove_tags = [
        dict(name='hr'),
        dict(name='script'),
        dict(name='style'),
        dict(name='aside'),
        dict(name='footer'),
        dict(name='nav'),
        dict(name='div', attrs={'class': ['tag','tags','category','sidebar','ad','related','share','entry-meta']}),
        dict(name='span', attrs={'class': ['tag','tags']}),
    ]

    keep_only_tags = [
        dict(name='h1'),
        dict(name='div', attrs={'class': 'entry-content'}),
    ]

    def preprocess_html(self, soup):
        # 删除所有链接
        for a in soup.find_all('a'):
            a.decompose()
        # 繁体转简体
        text_nodes = soup.find_all(text=True)
        for node in text_nodes:
            if node.parent.name not in ('script','style'):
                node.replace_with(simplify_chinese(node.string))
        return soup

    feeds = [
        ('科技新报全站', 'https://technews.tw/feed'),
    ]
