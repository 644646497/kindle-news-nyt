    # ... (前面的代码保持不变) ...

    def filter_articles(self, articles, log):
        """
        过滤文章：只保留符合“首页”调性的文章，剔除纯财报快讯
        """
        filtered = []
        for article in articles:
            title = article.get('title', '').lower()
            url = article.get('url', '').lower()

            # 1. 排除财经子域名的文章 (虽然主站RSS通常不含这些，但以防万一)
            if 'finance.technews.tw' in url:
                continue

            # 2. 排除典型的“财报快讯”标题特征
            # 首页通常不会放这种纯数据的短讯
            if any(keyword in title for keyword in ['營收', '財報', '月增', '年增']):
                # 除非标题很长（可能是深度分析），否则跳过短标题的财报
                if len(title) < 15:
                    continue

            # 3. 排除特定的非新闻分类（可选，根据需要调整）
            # 比如你想看所有分类，就不需要这一步；如果想只看科技，可以加判断

            filtered.append(article)

        return filtered

    # 修改 feeds 列表
    # 这里使用主站 Feed，它最接近首页内容
    feeds = [
        ('科技新报 - 首页精选', 'https://technews.tw/feed/'),
    ]
