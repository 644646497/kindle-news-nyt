import os, time, re, datetime
from calibre.web.feeds.news import BasicNewsRecipe

# 引入繁简转换库
try:
    from opencc import OpenCC
    cc = OpenCC('t2s') # t2s: Traditional to Simplified
    HAS_OPENCC = True
except ImportError:
    HAS_OPENCC = False

class TechNewsRecipe(BasicNewsRecipe):
    title = '科技新报 (TechNews)'
    language = 'zh_CN'
    oldest_article = 1
    max_articles_per_feed = 15
    
    # 【修改1】移除 auto_cleanup = True，防止自动清理机制与手动规则冲突
    remove_empty_feeds = True

    # 【修改2】核心清理逻辑：放宽匹配条件，覆盖更多可能的正文 class 或 id
    keep_only_tags = [
        dict(name='h1', attrs={'class': re.compile(r'post-title|entry-title', re.I)}),
        dict(name='div', attrs={'class': re.compile(r'post-content|entry-content|article-body|single-post-content|article-content', re.I)}),
        dict(name='div', attrs={'id': re.compile(r'post-content|entry-content|article-body', re.I)})
    ]

    # 【修改3】移除不需要的元素（优化正则，防止误杀正文容器）
    remove_tags = [
        dict(name=['script', 'style', 'iframe', 'form']),
        dict(name='div', attrs={'id': re.compile(r'^(comment|related|sidebar|ad|share)', re.I)}),
        dict(name='div', attrs={'class': re.compile(r'^(comment|related|sidebar|author-bio|post-nav)', re.I)}),
        dict(name='nav'),
        dict(name='footer'),
        dict(name='aside'),
        dict(name='hr'),
        # 移除所有的超链接，防止点击跳转或出现蓝色文字
        dict(name='a')
    ]

    def preprocess_html(self, soup):
        # 【修改4】增加调试日志，方便在 GitHub Actions 中查看匹配情况
        content_divs = soup.find_all('div', attrs={'class': re.compile(r'post-content|entry-content|article-body|single-post-content|article-content', re.I)})
        print(f"=== [Debug] 找到 {len(content_divs)} 个疑似正文的 div 标签 ===")

        # 1. 移除特定的“咖啡赞助”图片和文字
        for img in soup.find_all('img'):
            src = img.get('src', '')
            if 'coffee' in src.lower() or 'sponsor' in src.lower():
                img.decompose()

        # 2. 移除包含特定关键词的段落（针对文末尾巴）
        keywords_to_remove = ['延伸閱讀', '留給我們的話', 'downloaded by calibre', 'Section menu']
        for tag in soup.find_all(['p', 'div', 'span']):
            text = tag.get_text(strip=True)
            if any(kw in text for kw in keywords_to_remove):
                tag.decompose()

        return soup

    def postprocess_html(self, soup, first_fetch):
        # 3. 执行繁简转换
        if HAS_OPENCC:
            for element in soup.find_all(string=True):
                if element.strip():
                    # 检查是否包含繁体字特征，避免重复转换或转换英文
                    if re.search(r'[\u4e00-\u9fff]', element):
                        element.replace_with(cc.convert(element))
        return soup

    feeds = [('科技新报全站', 'https://technews.tw/feed')]
